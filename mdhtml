    idSpan.textContent = mark.dataset.hlId;
    var completeBtn = document.createElement('span');
    completeBtn.className = 'hl-del-btn';
    completeBtn.textContent = 'Complete';
    completeBtn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      completeHighlight(mark.dataset.hlId);
      removeDelPopup();
    });
    delPopup.appendChild(idSpan);
    delPopup.appendChild(completeBtn);
    delPopup.style.left = x + 'px';
    delPopup.style.top = (y + 20) + 'px';
    document.body.appendChild(delPopup);
  }

  function completeHighlight(id) {
    fetch('/__highlights__/' + id, {method:'DELETE'})
      .then(function(r){return r.json()})
      .then(function(){
        loadAndApply();
      })
      .catch(function(){});
  }

  // -- Events --
  document.addEventListener('mouseup', function(e){
    if (e.target.closest('.hl-popup, .hl-delete-popup, .sidebar')) return;
    setTimeout(function(){
      var selection = selectedHighlightData();
      removeSelPopup();
      removeDelPopup();
      if (!selection) return;
      var range = window.getSelection().getRangeAt(0);
      var rect = range.getBoundingClientRect();
      showSelPopup(rect.left + rect.width/2 - 50, rect.top, selection);
    }, 10);
  });

  content.addEventListener('click', function(e){
    if (e.target.tagName === 'MARK' && e.target.classList.contains('mdhtml-hl')) {
      e.preventDefault();
      e.stopPropagation();
      removeSelPopup();
      var rect = e.target.getBoundingClientRect();
      showDelPopup(e.target, rect.left + rect.width/2 - 50, rect.top);
    } else {
      removeDelPopup();
    }
  });

  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') { removeSelPopup(); removeDelPopup(); }
  });

  // -- SSE: listen for highlight updates --
  try {
    var es = new EventSource('/__reload__');
    es.addEventListener('highlights-updated', function(){
      loadAndApply();
    });
  } catch(e) {}

  // -- Initial load --
  loadAndApply();
})();
</script>` : "";

  const sidebarHtml = tocHtml ? `  <nav class="sidebar">
    <div class="sidebar-header"><div class="doc-title">${escapeHtml(title)}</div></div>
    <div class="toc">
${tocHtml}
    </div>
  </nav>` : "";

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>${escapeHtml(title)}</title>
