#!/usr/bin/env node
// mdhtml — render markdown to a dark-themed HTML page with optional live reload.
//   mdhtml file.md              → writes file.html
//   mdhtml --auto file.md       → serves + watches + live-reloads in browser
//   mdhtml -o out.html file.md  → specify output path
//   mdhtml --port 4040 --auto file.md
// Zero dependencies. Node 18+.

import { readFileSync, writeFileSync, watchFile, unwatchFile, statSync, existsSync } from "node:fs";
import { resolve, dirname, basename, extname, join } from "node:path";
import { createServer } from "node:http";
import { spawn, spawnSync } from "node:child_process";
import { randomBytes } from "node:crypto";
import { DatabaseSync } from "node:sqlite";

// ── CLI parsing ────────────────────────────────────────────────────────────
function parseArgs(argv) {
  const opts = { auto: false, port: 7231, output: null, open: true, theme: "github-dark", listHighlights: false, needsAttention: false, deleteHighlight: null, clearHighlights: false, addComment: null, commentText: null, addReply: null, replyText: null, resolveHighlight: null, unresolveHighlight: null, prime: false, files: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "prime") opts.prime = true;
    else if (a === "--auto" || a === "-a") opts.auto = true;
    else if (a === "--port" || a === "-p") opts.port = parseInt(argv[++i], 10);
    else if (a === "--output" || a === "-o") opts.output = argv[++i];
    else if (a === "--no-open") opts.open = false;
    else if (a === "--theme" || a === "-t") opts.theme = argv[++i];
    else if (a === "--list-highlights") opts.listHighlights = true;
    else if (a === "--needs-attention") opts.needsAttention = true;
    else if (a === "--delete-highlight") opts.deleteHighlight = argv[++i];
    else if (a === "--clear-highlights") opts.clearHighlights = true;
    else if (a === "--add-comment") opts.addComment = argv[++i];
    else if (a === "--comment-text") opts.commentText = argv[++i];
    else if (a === "--add-reply") opts.addReply = argv[++i];
    else if (a === "--reply-text") opts.replyText = argv[++i];
    else if (a === "--resolve-highlight") opts.resolveHighlight = argv[++i];
    else if (a === "--unresolve-highlight") opts.unresolveHighlight = argv[++i];
    else if (a === "--help" || a === "-h") {
      console.log(`mdhtml — markdown → dark HTML with live reload

Usage:
  mdhtml file.md                Write file.html
  mdhtml --auto file.md         Serve, watch, and live-reload in browser
  mdhtml -o out.html file.md    Specify output path
  mdhtml --port 4040 --auto file.md
  mdhtml --no-open --auto file.md   Don't auto-open browser

Options:
  --auto, -a        Start local server + watch for live reload
  --port, -p NUM    Server port (default 7231)
  --output, -o PATH Output file path (default: <input>.html)
  --no-open         Don't open browser automatically
  --theme, -t NAME  Color scheme: github-dark (default) or dracula
  --list-highlights List all highlights for the file
  --needs-attention List only highlights needing AI action (last msg from human, not resolved)
  --delete-highlight ID  Delete a highlight by its ID
  --clear-highlights Remove all highlights for the file
  --add-comment ID   Add an AI comment to a highlight (requires --comment-text)
  --comment-text TXT The comment text to add (used with --add-comment)
  --add-reply ID     Add a human reply to a highlight (requires --reply-text)
  --reply-text TXT   The reply text to add (used with --add-reply)
  --resolve-highlight ID    Mark a highlight as resolved
  --unresolve-highlight ID  Reopen a resolved highlight
  prime              Print instructions for AI agents on how to use this tool
  -h, --help        Show this help`);
      process.exit(0);
    } else if (a.startsWith("-")) {
      console.error(`Unknown option: ${a}`);
      process.exit(1);
    } else {
      opts.files.push(a);
    }
  }
  return opts;
}

// ── Highlight storage (SQLite) ─────────────────────────────────────────────
function dbFilePath(inputPath) {
  const canonicalPath = `${inputPath}.highlights.db`;
  const legacyPath = inputPath.replace(/\.md$/i, ".highlights.db");
  // SQLite sidecars originally dropped the .md suffix. Keep using an
  // existing legacy sidecar so upgrading does not hide prior highlights.
  if (canonicalPath !== legacyPath && !existsSync(canonicalPath) && existsSync(legacyPath)) {
    return legacyPath;
  }
  return canonicalPath;
}

function openDb(inputPath) {
  const dbPath = dbFilePath(inputPath);
  const db = new DatabaseSync(dbPath);
  db.exec("PRAGMA journal_mode = WAL");
  db.exec("PRAGMA busy_timeout = 5000");
  db.exec(`
    CREATE TABLE IF NOT EXISTS highlights (
      id TEXT PRIMARY KEY,
      text TEXT NOT NULL,
      section_id TEXT,
      section_title TEXT,
      resolved INTEGER DEFAULT 0,
      completed INTEGER DEFAULT 0,
      created_at TEXT NOT NULL,
      completed_at TEXT
    );
    CREATE TABLE IF NOT EXISTS messages (
      id TEXT PRIMARY KEY,
      highlight_id TEXT NOT NULL,
      author TEXT NOT NULL,
      text TEXT NOT NULL,
      created_at TEXT NOT NULL,
      seq INTEGER NOT NULL,
      FOREIGN KEY (highlight_id) REFERENCES highlights(id)
    );
    CREATE INDEX IF NOT EXISTS idx_messages_highlight ON messages(highlight_id, seq);
  `);
  return db;
}

function loadHighlights(inputPath) {
  const db = openDb(inputPath);
  try {
    const rows = db.prepare(`
      SELECT id, text, section_id, section_title, resolved, completed, created_at, completed_at
      FROM highlights ORDER BY created_at
    `).all();
    return rows.map((r) => {
      const msgs = db.prepare(`
        SELECT id, author, text, created_at FROM messages
        WHERE highlight_id = ? ORDER BY seq
      `).all(r.id);
      return {
        id: r.id,
        text: r.text,
        sectionId: r.section_id,
        sectionTitle: r.section_title,
        resolved: !!r.resolved,
        completed: !!r.completed,
        createdAt: r.created_at,
        completedAt: r.completed_at || undefined,
        messages: msgs.map((m) => ({ id: m.id, author: m.author, text: m.text, createdAt: m.created_at })),
      };
    });
  } finally {
    db.close();
  }
}

function genHighlightId() {
  return "hl-" + randomBytes(3).toString("hex");
}

function addHighlight(inputPath, data) {
  const db = openDb(inputPath);
  try {
    const id = genHighlightId();
    const now = new Date().toISOString();
    db.prepare(`
      INSERT INTO highlights (id, text, section_id, section_title, resolved, completed, created_at)
      VALUES (?, ?, ?, ?, 0, 0, ?)
    `).run(id, data.text, data.sectionId || null, data.sectionTitle || null, now);
    let messages = [];
    if (data.note) {
      const msgId = "msg-" + randomBytes(3).toString("hex");
      db.prepare(`
        INSERT INTO messages (id, highlight_id, author, text, created_at, seq)
        VALUES (?, ?, 'human', ?, ?, 0)
      `).run(msgId, id, data.note, now);
      messages = [{ id: msgId, author: "human", text: data.note, createdAt: now }];
    }
    return { id, text: data.text, sectionId: data.sectionId, sectionTitle: data.sectionTitle, resolved: false, completed: false, createdAt: now, messages };
  } finally {
    db.close();
  }
}

function setHighlightNote(inputPath, id, note) {
  const db = openDb(inputPath);
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ?").get(id);
    if (!existing) return null;
    const humanMsg = db.prepare("SELECT id FROM messages WHERE highlight_id = ? AND author = 'human' ORDER BY seq LIMIT 1").get(id);
    if (humanMsg) {
      db.prepare("UPDATE messages SET text = ? WHERE id = ?").run(note, humanMsg.id);
    } else {
      const seq = db.prepare("SELECT COALESCE(MAX(seq), -1) + 1 as next FROM messages WHERE highlight_id = ?").get(id);
      const msgId = "msg-" + randomBytes(3).toString("hex");
      db.prepare("INSERT INTO messages (id, highlight_id, author, text, created_at, seq) VALUES (?, ?, 'human', ?, ?, ?)").run(msgId, id, note, new Date().toISOString(), seq.next);
    }
    return loadHighlights(inputPath).find((h) => h.id === id) || null;
  } finally {
    db.close();
  }
}

function addHighlightMessage(inputPath, id, author, text) {
  const db = openDb(inputPath);
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ?").get(id);
    if (!existing) return null;
    const seq = db.prepare("SELECT COALESCE(MAX(seq), -1) + 1 as next FROM messages WHERE highlight_id = ?").get(id);
    const msgId = "msg-" + randomBytes(3).toString("hex");
    const now = new Date().toISOString();
    db.prepare("INSERT INTO messages (id, highlight_id, author, text, created_at, seq) VALUES (?, ?, ?, ?, ?, ?)").run(msgId, id, author, text, now, seq.next);
    const msg = { id: msgId, author, text, createdAt: now };
    const hl = loadHighlights(inputPath).find((h) => h.id === id);
    return { highlight: hl, message: msg };
  } finally {
    db.close();
  }
}

function setHighlightResolved(inputPath, id, resolved) {
  const db = openDb(inputPath);
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ?").get(id);
    if (!existing) return null;
    db.prepare("UPDATE highlights SET resolved = ? WHERE id = ?").run(resolved ? 1 : 0, id);
    return loadHighlights(inputPath).find((h) => h.id === id) || null;
  } finally {
    db.close();
  }
}

function removeHighlight(inputPath, id) {
  const db = openDb(inputPath);
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ?").get(id);
    if (!existing) return false;
    const now = new Date().toISOString();
    db.prepare("UPDATE highlights SET completed = 1, resolved = 1, completed_at = ? WHERE id = ?").run(now, id);
    return true;
  } finally {
    db.close();
  }
}

function clearAllHighlights(inputPath) {
  const db = openDb(inputPath);
  try {
    const now = new Date().toISOString();
    db.prepare("UPDATE highlights SET completed = 1, resolved = 1, completed_at = ? WHERE completed = 0").run(now);
    return true;
  } finally {
    db.close();
  }
}

function lastMessageAuthor(hl) {
  if (!hl.messages || hl.messages.length === 0) return null;
  return hl.messages[hl.messages.length - 1].author;
}

function printHighlights(inputPath, filter) {
  let highlights = loadHighlights(inputPath);
  const fname = basename(inputPath);

  if (filter === "needs-attention") {
    highlights = highlights.filter((h) => !h.completed && !h.resolved && lastMessageAuthor(h) === "human");
  }

  if (highlights.length === 0) {
    const label = filter === "needs-attention" ? "needing attention" : "";
    console.log(`  No highlights ${label} for ${fname}`);
    return;
  }

  const open = highlights.filter((h) => !h.resolved && !h.completed).length;
  const resolved = highlights.filter((h) => h.resolved && !h.completed).length;
  const completed = highlights.filter((h) => h.completed).length;
  const summary = `${highlights.length} total, ${open} open, ${resolved} resolved, ${completed} completed`;
  console.log(`  Highlights for ${fname} (${summary}):\n`);

  for (const h of highlights) {
    const section = h.sectionId ? `§${h.sectionId}` : "§(top)";
    const preview = h.text.length > 80 ? h.text.slice(0, 77) + "…" : h.text;
    let status = "";
    if (h.completed) status = " [COMPLETED]";
    else if (h.resolved) status = " [RESOLVED]";
    console.log(`  ${h.id}  ${section}${status}`);
    console.log(`    "${preview}"`);
    if (h.messages && h.messages.length > 0) {
      for (const m of h.messages) {
        const label = m.author === "human" ? "YOU" : "AI";
        const mprev = m.text.length > 80 ? m.text.slice(0, 77) + "…" : m.text;
        console.log(`    [${label}] ${mprev}`);
      }
    }
    console.log(`    created: ${h.createdAt}`);
    if (h.completedAt) console.log(`    completed: ${h.completedAt}`);
    console.log();
  }
}

// ── Markdown helpers ───────────────────────────────────────────────────────
function escapeHtml(s) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

// ── TOC extraction ─────────────────────────────────────────────────────────
function extractToc(html) {
  const re = /<h([123])\s+id="([^"]+)"[^>]*>(.*?)<\/h\1>/gi;
  const entries = [];
  let m;
  while ((m = re.exec(html)) !== null) {
    entries.push({
      level: parseInt(m[1]),
      id: m[2],
      text: m[3].replace(/<[^>]+>/g, ""),
    });
  }
  return entries;
}

function buildTocHtml(entries) {
  if (entries.length === 0) return "";
  const minLevel = Math.min(...entries.map((e) => e.level));
  let html = "";
  for (const e of entries) {
    const indent = (e.level - minLevel) * 16;
    html += `<a href="#${e.id}" class="toc-link toc-l${e.level}" data-target="${e.id}" style="padding-left:${12 + indent}px"><span>${escapeHtml(e.text)}</span></a>\n`;
  }
  return html;
}

// ── Frontmatter extraction ─────────────────────────────────────────────────
function extractFrontmatter(rawMd) {
  const lines = rawMd.split("\n");
  let h1Idx = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^#\s+/.test(lines[i])) { h1Idx = i; break; }
  }
  if (h1Idx === -1) return { frontmatter: null, md: rawMd };

  // Collect non-blank lines after H1 until a blank line
  const blockStart = h1Idx + 1;
  // skip blank lines between H1 and content
  let idx = blockStart;
  while (idx < lines.length && lines[idx].trim() === "") idx++;
  const blockLines = [];
  while (idx < lines.length && lines[idx].trim() !== "") {
    blockLines.push(lines[idx]);
    idx++;
  }

  // Check if this block is frontmatter (multiple **Label:** entries)
  const labelRe = /^\*\*([^*]+):\*\*\s*(.*)$/;
  const matched = blockLines.filter((l) => labelRe.test(l)).length;
  if (matched < 2) return { frontmatter: null, md: rawMd };

  // Group lines into fields
  const fields = [];
  let current = null;
  for (const line of blockLines) {
    const m = line.match(labelRe);
    if (m) {
      if (current) fields.push(current);
      current = { label: m[1], value: m[2] };
    } else if (current) {
      current.value += " " + line.trim();
    }
  }
  if (current) fields.push(current);

  // Remove the frontmatter block from the markdown
  // Keep the H1 and everything after the blank line that ends the block
  const before = lines.slice(0, blockStart).join("\n");
  const after = lines.slice(idx).join("\n");
  const cleanedMd = before + "\n" + after;

  return { frontmatter: fields, md: cleanedMd };
}

function buildFrontmatterHtml(fields) {
  if (!fields || fields.length === 0) return "";
  let html = '<div class="frontmatter">\n';
  for (const f of fields) {
    html += `  <div class="fm-field"><span class="fm-label">${escapeHtml(f.label)}</span><span class="fm-value">${renderInlinePandoc(f.value)}</span></div>\n`;
  }
  html += "</div>";
  return html;
}

// Render a single inline string through pandoc for correctness
function renderInlinePandoc(text) {
  const result = spawnSync("pandoc", [
    "--from", "markdown+autolink_bare_uris",
    "--to", "html5",
    "--no-highlight",
  ], { input: text, encoding: "utf-8" });
  let out = result.stdout ? result.stdout.trim() : escapeHtml(text);
  // Strip wrapping <p> tags since this is inline content
  out = out.replace(/^<p>([\s\S]*)<\/p>$/, "$1");
  return out;
}

