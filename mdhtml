  or clear them all at once when done.
- The highlight text is the exact passage from the document at the time
  the human selected it. Use it to locate the relevant section.
- After editing, save the file. The browser will auto-reload and the
  human can verify your changes.`);
  process.exit(0);
}

if (opts.files.length === 0) {
  console.error("Usage: mdhtml [--auto] [--port N] [--output PATH] file.md");
  process.exit(1);
}

const inputPath = resolve(opts.files[0]);

try {
  statSync(inputPath);
} catch (e) {
  console.error(`File not found: ${inputPath}`);
  process.exit(1);
}

// ── Highlight CLI commands ─────────────────────────────────────────────────
if (opts.listHighlights) {
  printHighlights(inputPath);
  process.exit(0);
}

if (opts.clearHighlights) {
  saveHighlights(inputPath, []);
  console.log(`  cleared all highlights for ${basename(inputPath)}`);
  process.exit(0);
}

if (opts.deleteHighlight) {
  const removed = removeHighlight(inputPath, opts.deleteHighlight);
  if (removed) {
    console.log(`  deleted ${opts.deleteHighlight} from ${basename(inputPath)}`);
  } else {
    console.error(`  highlight ${opts.deleteHighlight} not found`);
    process.exit(1);
  }
  process.exit(0);
}

// ── Auto / static ──────────────────────────────────────────────────────────
if (opts.auto) {
  serveAuto(inputPath, opts);
} else {
  const outputPath = resolve(opts.output || inputPath.replace(/\.md$/i, ".html"));
  writeStatic(inputPath, outputPath);
}
