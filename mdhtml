  }

  function escapeText(s) {
    var d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function renderPanel(hls) {
    var countEl = document.getElementById('hl-panel-count');
    var listEl = document.getElementById('hl-panel-list');
    var filterBtn = document.getElementById('hl-filter-btn');
    if (filterBtn) {
      filterBtn.classList.toggle('active', hideResolved);
      filterBtn.textContent = hideResolved ? 'Show resolved' : 'Hide resolved';
      filterBtn.onclick = function() {
        hideResolved = !hideResolved;
        renderPanel(hls);
      };
    }
    var visible = hideResolved ? hls.filter(function(h){ return !h.resolved && !h.completed; }) : hls;
    if (countEl) countEl.textContent = '(' + visible.length + (visible.length !== hls.length ? '/' + hls.length : '') + ')';
    if (!listEl) return;
    if (visible.length === 0) {
      listEl.innerHTML = '<div class="hl-panel-empty">' + (hls.length > 0 ? 'All highlights resolved.' : 'Select text in the document to highlight passages.') + '</div>';
      return;
    }
    var html = '';
    for (var i = 0; i < visible.length; i++) {
      var h = visible[i];
      var preview = h.text.length > 120 ? h.text.slice(0, 117) + '\\u2026' : h.text;
      var section = h.sectionTitle ? escapeText(h.sectionTitle) : '(top)';
      var cardClass = 'hl-card';
      if (h.completed) cardClass += ' completed';
      else if (h.resolved) cardClass += ' resolved';
      if (h.aiState === 'thinking') cardClass += ' ai-thinking';
      if (h.scope === 'document') cardClass += ' directive';

      var directiveTag = h.scope === 'document' ? '<div class="hl-card-directive-tag">\\u2728 Message to the AI</div>' : '';

      var aiStateHtml = h.aiState === 'thinking' ? '<span class="hl-card-aistate">thinking</span>' : '';

      var statusHtml = '';
      if (h.completed) statusHtml = '<span class="hl-card-status completed">\\u2713 Done</span>';
      else if (h.resolved) statusHtml = '<span class="hl-card-status resolved">\\u2713 Resolved</span>';

      var resolveBtn = '';
      if (!h.completed) {
        resolveBtn = '<span class="hl-card-resolve-btn' + (h.resolved ? ' resolved' : '') + '" data-action="' + (h.resolved ? 'unresolve' : 'resolve') + '">' + (h.resolved ? 'Reopen' : 'Resolve') + '</span>';
      }

      // Conversation thread
      var threadHtml = '';
      if (h.messages && h.messages.length > 0) {
        threadHtml = '<div class="hl-thread">';
        for (var j = 0; j < h.messages.length; j++) {
          var m = h.messages[j];
          var author = m.author === 'human' ? 'YOU' : 'AI';
          var msgClass = m.author === 'human' ? 'human' : 'ai';
          threadHtml += '<div class="hl-msg hl-msg-' + msgClass + '">'
            + '<div class="hl-msg-header ' + msgClass + '">' + author + '</div>'
            + escapeText(m.text)
            + '</div>';
        }
        threadHtml += '</div>';
      }

      // Pending suggested edits (rendered as an accept/reject diff card)
      var suggHtml = '';
      var pending = (h.suggestions || []).filter(function(s){ return s.status === 'pending'; });
      for (var k = 0; k < pending.length; k++) {
        var s = pending[k];
        suggHtml += '<div class="hl-suggestion" data-sugg-id="' + s.id + '">'
          + '<div class="hl-suggestion-label">\\u270e Suggested edit</div>'
          + '<div class="hl-suggestion-diff">'
          +   '<span class="sugg-del">' + escapeText(s.anchor) + '</span>'
          +   '<span class="sugg-ins">' + escapeText(s.replacement) + '</span>'
          + '</div>'
          + '<div class="hl-suggestion-actions">'
          +   '<span class="sugg-btn accept" data-action="accept">\\u2713 Approve</span>'
          +   '<span class="sugg-btn reject" data-action="reject">Dismiss</span>'
          + '</div>'
          + '</div>';
      }

      // Reply link (only if not completed)
      var replyHtml = '';
      if (!h.completed) {
        replyHtml = '<div class="hl-add-reply" data-action="reply">+ reply</div>';
      }

      html += '<div class="' + cardClass + '" data-hl-id="' + h.id + '">'
        + directiveTag
        + '<div class="hl-card-text">' + escapeText(preview) + '</div>'
        + '<div class="hl-card-meta"><span class="hl-card-id">' + h.id + '</span><span class="hl-card-section">' + section + '</span>' + aiStateHtml + statusHtml + resolveBtn + '</div>'
        + threadHtml
        + suggHtml
        + replyHtml
        + '</div>';
    }
    listEl.innerHTML = html;

    listEl.querySelectorAll('.hl-card').forEach(function(card){
      var id = card.dataset.hlId;
      var mark = content.querySelector('mark.mdhtml-hl[data-hl-id="' + id + '"]');
      var h = hls.find(function(x){return x.id === id});

      // Click anywhere on the card (except its interactive controls) to jump to
      // the passage in the document and flash it so it's easy to spot.
      card.addEventListener('click', function(e){
        if (e.target.closest('.hl-card-resolve-btn, .hl-add-reply, .hl-reply-box, .hl-reply-actions, .sugg-btn, .hl-suggestion')) return;
        revealHighlight(id);
      });

      // Resolve/unresolve button
      var resolveEl = card.querySelector('.hl-card-resolve-btn');
      if (resolveEl) {
        resolveEl.addEventListener('click', function(e){
          e.stopPropagation();
          var action = resolveEl.dataset.action;
          fetch(apiBase + '/__highlights__/' + id + '/' + action, { method: 'PATCH' })
            .then(function(r){return r.json()})
            .then(function(){ loadAndApply(); })
            .catch(function(){});
        });
      }

      // Reply link
      var replyEl = card.querySelector('.hl-add-reply');
      if (replyEl) {
        replyEl.addEventListener('click', function(e){
          e.stopPropagation();
          openReplyBox(card, id);
        });
      }

      // Suggestion approve/dismiss buttons
      card.querySelectorAll('.hl-suggestion').forEach(function(sg){
        var sid = sg.dataset.suggId;
        sg.querySelectorAll('.sugg-btn').forEach(function(btn){
          btn.addEventListener('click', function(e){
            e.stopPropagation();
            resolveSuggestion(sid, btn.dataset.action);
          });
        });
      });
    });
  }

  // Approve (splice into the document) or dismiss a suggested edit. Surfaces
  // failures (e.g. the anchor no longer matches the source) instead of failing
  // silently, so the reviewer knows the click did not take effect.
  function resolveSuggestion(sid, action) {
    fetch(apiBase + '/__suggestions__/' + sid + '/' + action, { method: 'PATCH' })
      .then(function(r){
        if (!r.ok) return r.json().catch(function(){ return {}; }).then(function(e){ throw new Error(e.error || ('HTTP ' + r.status)); });
        return r.json();
      })
      .then(function(){
        if (window.__spotlightFlash) window.__spotlightFlash(action === 'accept' ? 'Applied' : 'Dismissed');
        loadAndApply();
      })
      .catch(function(err){
        if (window.__spotlightFlash) window.__spotlightFlash(action === 'accept' ? "Couldn't apply — text changed" : "Couldn't dismiss");
      });
  }

  // -- Inline suggestion overlays: anchor a hover popover to the highlighted
  //    passage so the reviewer sees the proposed change without the text
  //    reflowing. The document text is never mutated until Approve is clicked.
  function clearInlineSuggestions() {
    content.querySelectorAll('mark.mdhtml-hl.has-suggestion').forEach(function(m){
      m.classList.remove('has-suggestion');
    });
    var pop = document.getElementById('sugg-popover');
    if (pop) pop.remove();
  }

  function applyInlineSuggestions(hls) {
    hls.forEach(function(h){
      var pending = (h.suggestions || []).filter(function(s){ return s.status === 'pending'; });
      if (!pending.length) return;
      if (h.scope === 'document') {
        // A whole-document directive has no single passage; anchor each of its
        // suggestions to its own target text wherever that appears.
        pending.forEach(function(s){
          var marks = wrapTextOccurrence(s.anchor, function(mark){
            mark.className = 'mdhtml-hl has-suggestion';
            mark.dataset.hlId = h.id;
            mark.dataset.suggId = s.id;
          });
          if (marks) marks.forEach(function(m){
            m.addEventListener('mouseenter', function(){ showSuggPopover(m, s); });
          });
        });
        return;
      }
      var marks = content.querySelectorAll('mark.mdhtml-hl[data-hl-id="' + h.id + '"]');
      if (!marks.length) return;
      marks.forEach(function(m){ m.classList.add('has-suggestion'); });
      // Attach hover to reveal the suggestion popover anchored above the mark.
      marks.forEach(function(m){
        m.addEventListener('mouseenter', function(){ showSuggPopover(m, pending[0]); });
      });
    });
  }

  var suggPopoverHideTimer = null;
  function showSuggPopover(mark, sugg) {
    var existing = document.getElementById('sugg-popover');
    if (existing && existing.dataset.suggId === sugg.id) { if (suggPopoverHideTimer) { clearTimeout(suggPopoverHideTimer); suggPopoverHideTimer = null; } return; }
    if (existing) existing.remove();
    var pop = document.createElement('div');
    pop.id = 'sugg-popover';
    pop.className = 'sugg-popover';
    pop.dataset.suggId = sugg.id;
    pop.innerHTML = '<div class="sugg-popover-label">\\u270e Suggested edit</div>'
      + '<div class="sugg-popover-diff"><span class="sugg-del">' + escapeText(sugg.anchor) + '</span>'
      + '<span class="sugg-ins">' + escapeText(sugg.replacement) + '</span></div>'
      + '<div class="sugg-popover-actions">'
      +   '<span class="sugg-btn accept" data-action="accept">\\u2713 Approve</span>'
      +   '<span class="sugg-btn reject" data-action="reject">Dismiss</span>'
      + '</div>';
    document.body.appendChild(pop);
    var rect = mark.getBoundingClientRect();
    // Fixed + zoom-aware: anchor just above the mark, flipping below if needed.
    placeFixedPopup(pop, rect.left, rect.top, 'above');
    pop.querySelectorAll('.sugg-btn').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        resolveSuggestion(sugg.id, btn.dataset.action);
      });
    });
    function scheduleHide(){ suggPopoverHideTimer = setTimeout(function(){ if (pop.parentNode) pop.remove(); }, 260); }
    function cancelHide(){ if (suggPopoverHideTimer) { clearTimeout(suggPopoverHideTimer); suggPopoverHideTimer = null; } }
    pop.addEventListener('mouseenter', cancelHide);
    pop.addEventListener('mouseleave', scheduleHide);
    mark.addEventListener('mouseleave', scheduleHide);
  }

  function openReplyBox(card, id) {
    var existing = card.querySelector('.hl-reply-box');
    if (existing) { existing.focus(); return; }
    var replyLink = card.querySelector('.hl-add-reply');
    if (replyLink) replyLink.style.display = 'none';
    var editor = document.createElement('textarea');
    editor.className = 'hl-reply-box';
    editor.placeholder = 'Reply to the AI\\u2026';
    card.appendChild(editor);
    var actions = document.createElement('div');
    actions.className = 'hl-reply-actions';
    var sendBtn = document.createElement('span');
    sendBtn.className = 'hl-reply-btn primary';
    sendBtn.textContent = 'Send';
    var cancelBtn = document.createElement('span');
    cancelBtn.className = 'hl-reply-btn';
    cancelBtn.textContent = 'Cancel';
    actions.appendChild(sendBtn);
    actions.appendChild(cancelBtn);
    card.appendChild(actions);
    editor.focus();
    function cleanup() {
      editor.remove();
      actions.remove();
      if (replyLink) replyLink.style.display = '';
    }
    sendBtn.addEventListener('click', function(e){
      e.stopPropagation();
      var text = editor.value.trim();
      if (!text) { cleanup(); return; }
      fetch(apiBase + '/__highlights__/' + id + '/messages', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ author: 'human', text: text })
      }).then(function(r){return r.json()}).then(function(){
        loadAndApply();
      }).catch(function(){});
    });
    cancelBtn.addEventListener('click', function(e){
      e.stopPropagation();
      cleanup();
    });
    editor.addEventListener('keydown', function(e){
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); sendBtn.click(); }
      if (e.key === 'Escape') { e.preventDefault(); cleanup(); }
    });
  }

  // Serialize renders: rapid SSE updates (e.g. an agent posting several
  // suggestions in a burst) would otherwise let concurrent fetches interleave
  // and clobber each other's DOM edits. Run one at a time; coalesce the rest.
  var loadInFlight = false, loadQueued = false;
  function loadAndApply() {
    if (loadInFlight) { loadQueued = true; return; }
    loadInFlight = true;
    fetch(apiBase + '/__highlights__').then(function(r){return r.json()}).then(function(hls){
      clearInlineSuggestions();
      clearHighlights();
      hls.forEach(applyHighlight);
      applyInlineSuggestions(hls);
      applyAiActivity(hls);
      renderPanel(hls);
    }).catch(function(){}).finally(function(){
      loadInFlight = false;
      if (loadQueued) { loadQueued = false; loadAndApply(); }
    });
  }

  // AI activity overlays: pulse a highlight yellow while the agent has claimed
  // it ("thinking"), and flash it green the moment a new AI response (comment
  // or suggestion) arrives for it.
  var prevAiSig = null;
  function aiSignature(h) {
    var aiMsgs = (h.messages || []).filter(function(m){ return m.author === 'ai'; }).length;
    var suggs = (h.suggestions || []).length;
    return aiMsgs + ':' + suggs;
  }
  function applyAiActivity(hls) {
    var newSig = {};
    hls.forEach(function(h){
      newSig[h.id] = aiSignature(h);
      var marks = content.querySelectorAll('mark.mdhtml-hl[data-hl-id="' + h.id + '"]');
      if (h.aiState === 'thinking') {
        marks.forEach(function(m){ m.classList.add('ai-thinking'); });
      } else if (prevAiSig && prevAiSig[h.id] !== undefined && prevAiSig[h.id] !== newSig[h.id]) {
        marks.forEach(function(m){
          m.classList.add('ai-responded');
          (function(mk){ setTimeout(function(){ mk.classList.remove('ai-responded'); }, 1600); })(m);
        });
        if (window.__spotlightFlash) window.__spotlightFlash('AI responded');
      }
    });
    prevAiSig = newSig;
    // A whole-document message has no passage to pulse, so surface the AI's
    // "working" state on the composer itself.
    var composer = document.getElementById('doc-composer');
    if (composer) {
      var docThinking = hls.some(function(h){ return h.scope === 'document' && h.aiState === 'thinking'; });
      composer.classList.toggle('ai-thinking', docThinking);
    }
  }

  // In-place document refresh: fetch freshly rendered fragments and patch the
  // DOM without a full navigation, so scroll position, zoom, and text
  // selection all survive. Highlights and suggestions are re-applied after.
  function patchContent() {
    fetch(apiBase + '/__content__').then(function(r){return r.json()}).then(function(data){
      var scrollY = window.scrollY;
      if (data.title) {
        document.title = data.title;
        var docTitleEl = document.querySelector('.sidebar-header .doc-title');
        if (docTitleEl) docTitleEl.textContent = data.title;
      }
      content.innerHTML = (data.frontmatterHtml ? data.frontmatterHtml + '\\n' : '') + (data.bodyHtml || '');
      var toc = document.querySelector('.toc');
      if (toc) toc.innerHTML = data.tocHtml || '';
      window.scrollTo(0, scrollY);
      if (window.__initScrollSpy) window.__initScrollSpy();
      if (window.__spotlightFlash) window.__spotlightFlash('Updated');
      loadAndApply();
    }).catch(function(){});
  }

  // -- Nearest preceding heading --
  function nearestHeading(range) {
    var startEl = range.startContainer;
    if (startEl.nodeType === 3) startEl = startEl.parentElement;
    var headings = content.querySelectorAll('h1, h2, h3, h4, h5, h6');
    var nearest = null;
    for (var i = 0; i < headings.length; i++) {
      if (headings[i].compareDocumentPosition(startEl) & Node.DOCUMENT_POSITION_FOLLOWING) {
        nearest = headings[i];
      } else { break; }
    }
    return nearest ? { id: nearest.id, title: nearest.textContent.replace(/<[^>]+>/g,'') } : null;
  }

  function selectedHighlightData() {
    var sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return null;
    var range = sel.getRangeAt(0);
    if (!content.contains(range.commonAncestorContainer)) return null;
    var text = sel.toString().trim();
    if (text.length < 2) return null;
    var heading = nearestHeading(range);
    return {
      text: text,
      sectionId: heading ? heading.id : null,
      sectionTitle: heading ? heading.title : null
    };
  }

  // -- Selection popup --
  function removeSelPopup() {
    if (selPopup) { selPopup.remove(); selPopup = null; }
    clearPending();
  }

  function showSelPopup(x, y, selection) {
    removeSelPopup();
    selPopup = document.createElement('div');
    selPopup.className = 'hl-popup';
    selPopup.style.padding = '8px 10px';
    selPopup.style.flexDirection = 'column';
    selPopup.style.gap = '6px';
    selPopup.style.alignItems = 'stretch';
    var btn = document.createElement('div');
    btn.textContent = '\\u2726 Highlight';
    btn.style.textAlign = 'center';
    var noteInput = document.createElement('input');
    noteInput.type = 'text';
    noteInput.placeholder = 'Note (optional)\\u2026';
    noteInput.style.background = 'var(--bg)';
    noteInput.style.border = '1px solid var(--border)';
    noteInput.style.borderRadius = '4px';
    noteInput.style.padding = '3px 6px';
    noteInput.style.fontSize = '12px';
    noteInput.style.color = 'var(--text)';
    noteInput.style.width = '160px';
    noteInput.style.outline = 'none';
    selPopup.appendChild(noteInput);
    selPopup.appendChild(btn);
    // Mark the selected passage now, before focusing the input clears the
    // browser's live selection, so the reviewer keeps seeing what they picked.
    markPendingSelection();
    selPopup.addEventListener('mousedown', function(e){ e.preventDefault(); });
    function submit(event) {
      // Click handlers receive an event, but keyboard submission calls this
      // helper directly. Do not make creating a highlight depend on one.
      if (event) {
        event.preventDefault();
        event.stopPropagation();
      }
      createHighlightFromSelection(selection, noteInput.value.trim());
      removeSelPopup();
    }
    btn.addEventListener('click', submit);
    noteInput.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); submit(e); }
      if (e.key === 'Escape') { e.preventDefault(); removeSelPopup(); }
    });
    document.body.appendChild(selPopup);
    // Position above the selection. Popups are fixed but scaled by the root
    // zoom, so divide viewport coordinates by the zoom factor; use offsetHeight
    // (local px) to sit the popup just above the passage.
    placeFixedPopup(selPopup, x, y, 'above');
    setTimeout(function(){ noteInput.focus(); }, 50);
  }

  // Position a fixed popup so it renders at the given viewport (visual)
  // coordinates regardless of the app zoom. place is 'above' or 'below' the
  // anchor y.
  function placeFixedPopup(el, xVisual, yVisual, place) {
    var z = window.__spotlightZoom || 1;
    var localLeft = xVisual / z;
    var maxLeft = (window.innerWidth / z) - el.offsetWidth - 6;
    if (localLeft > maxLeft) localLeft = maxLeft;
    if (localLeft < 6) localLeft = 6;
    var localTop;
    if (place === 'below') {
      localTop = (yVisual / z) + 10;
    } else {
      localTop = (yVisual / z) - el.offsetHeight - 10;
      if (localTop < 6) localTop = (yVisual / z) + 10; // flip below if no room
    }
    el.style.left = localLeft + 'px';
    el.style.top = localTop + 'px';
  }

  function createHighlightFromSelection(selection, note) {
    if (!selection || !selection.text) return;
    // Remove the temporary pending mark so the real highlight applies to clean
    // DOM (the text was already captured into the selection object).
    clearPending();
    var body = JSON.stringify({
      text: selection.text,
      sectionId: selection.sectionId,
      sectionTitle: selection.sectionTitle,
      note: note || undefined
    });
    fetch(apiBase + '/__highlights__', {method:'POST', headers:{'Content-Type':'application/json'}, body:body})
      .then(function(r){
        if (!r.ok) throw new Error('could not create highlight');
        return r.json();
      })
      .then(function(hl){
        var sel = window.getSelection();
        sel.removeAllRanges();
        applyHighlight(hl);
        loadAndApply();
      })
      .catch(function(){});
  }

  // -- Complete popup --
  function removeDelPopup() {
    if (delPopup) { delPopup.remove(); delPopup = null; }
  }

  function showDelPopup(mark, x, y) {
    removeDelPopup();
    delPopup = document.createElement('div');
    delPopup.className = 'hl-delete-popup';
    var idSpan = document.createElement('span');
    idSpan.className = 'hl-id';
    idSpan.textContent = mark.dataset.hlId;
    var completeBtn = document.createElement('span');
    completeBtn.className = 'hl-del-btn';
    completeBtn.textContent = 'Complete';
    completeBtn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      completeHighlight(mark.dataset.hlId);
      removeDelPopup();
    });
    delPopup.appendChild(idSpan);
    delPopup.appendChild(completeBtn);
    document.body.appendChild(delPopup);
    placeFixedPopup(delPopup, x, y, 'below');
  }

  function completeHighlight(id) {
    fetch(apiBase + '/__highlights__/' + id, {method:'DELETE'})
      .then(function(r){return r.json()})
      .then(function(){
        loadAndApply();
      })
      .catch(function(){});
  }

  // -- Events --
  document.addEventListener('mouseup', function(e){
    if (e.target.closest('.hl-popup, .hl-delete-popup, .sidebar, .spotlight-guide')) return;
    setTimeout(function(){
      var selection = selectedHighlightData();
      removeSelPopup();
      removeDelPopup();
      if (!selection) return;
      var range = window.getSelection().getRangeAt(0);
      var rect = range.getBoundingClientRect();
      showSelPopup(rect.left + rect.width/2 - 50, rect.top, selection);
    }, 10);
  });

  content.addEventListener('click', function(e){
    if (e.target.tagName === 'MARK' && e.target.classList.contains('mdhtml-hl')) {
      e.preventDefault();
      e.stopPropagation();
      removeSelPopup();
      var rect = e.target.getBoundingClientRect();
      showDelPopup(e.target, rect.left + rect.width/2 - 50, rect.top);
    } else {
      removeDelPopup();
    }
  });

  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') { removeSelPopup(); removeDelPopup(); }
  });

  // -- SSE: live updates. content-updated → patch the document in place;
  //    highlights-updated → re-fetch annotations (covers CLI-driven changes
  //    like an AI agent adding comments or suggestions). --
  try {
    var es = new EventSource(apiBase + '/__reload__');
    es.addEventListener('content-updated', function(){ patchContent(); });
    es.addEventListener('highlights-updated', function(){ loadAndApply(); });
    // Back-compat: an older server may still emit a plain reload event.
    es.addEventListener('reload', function(){ patchContent(); });
  } catch(e) {}

  // -- Initial load --
  loadAndApply();
})();
</script>` : "";

  // Whole-document composer: send the AI a message about the document as a
  // whole (e.g. "add a joke to the end of each section"). Sits in the
  // bottom-left, below the table of contents.
  const composerScript = autoMode ? `<div class="doc-composer" id="doc-composer">
  <div class="doc-composer-label">&#10024; Message the AI about the whole doc</div>
  <textarea id="doc-composer-input" rows="2" placeholder="e.g. add a joke to the end of each section"></textarea>
  <div class="doc-composer-row">
    <span class="doc-composer-status" id="doc-composer-status"></span>
    <button class="doc-composer-send" id="doc-composer-send">Send</button>
  </div>
</div>
<script>
(function(){
  var apiBase = ${apiBase};
  var input = document.getElementById('doc-composer-input');
  var sendBtn = document.getElementById('doc-composer-send');
  var status = document.getElementById('doc-composer-status');
  if (!input || !sendBtn) return;
  function send(){
    var text = input.value.trim();
    if (text.length < 2) { input.focus(); return; }
    sendBtn.disabled = true;
    status.textContent = 'Sending\\u2026';
    fetch(apiBase + '/__directives__', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({text: text})})
      .then(function(r){ if (!r.ok) throw new Error(); return r.json(); })
      .then(function(){
