}

try {
  if (opts.command) {
    const session = requireSession();
    if (opts.command === "list-highlights") {
      emit(loadHighlights(session.id).map((h) => ({ id: h.id, text: h.text.slice(0, 120), commentCount: h.messages.length, status: h.completed ? "completed" : h.resolved ? "resolved" : "open", createdAt: h.createdAt })));
    } else if (opts.command === "get-highlight-details") {
      if (!opts.highlightId) throw new Error("--highlight-id is required");
      const highlight = loadHighlights(session.id).find((h) => h.id === opts.highlightId);
      if (!highlight) throw new Error(`highlight ${opts.highlightId} not found`);
      emit(highlight);
    } else if (opts.command === "get-new-comments") {
      if (!opts.agentId) throw new Error("--agent-id is required");
      emit(await waitForUpdates(session.id, opts.agentId));
    } else if (opts.command === "ai-agent-mark-read") {
      if (!opts.highlightId || !opts.agentId) throw new Error("--highlight-id and --agent-id are required");
      if (!markRead(session.id, opts.highlightId, opts.agentId)) throw new Error(`highlight ${opts.highlightId} not found`);
      emit({ ok: true, highlightId: opts.highlightId, agentId: opts.agentId });
    } else if (opts.command === "add-comment") {
      if (!opts.highlightId || !opts.comment) throw new Error("--highlight-id and --comment are required");
      const result = addHighlightMessage(session.id, opts.highlightId, "ai", opts.comment, opts.agentId);
      if (!result) throw new Error(`highlight ${opts.highlightId} not found`);
      if (opts.agentId) markRead(session.id, opts.highlightId, opts.agentId);
      emit(result);
    } else if (opts.command === "ai-agent-mark-as-completed") {
      if (!opts.highlightId || !opts.comment) throw new Error("--highlight-id and --comment are required");
      const result = addHighlightMessage(session.id, opts.highlightId, "ai", opts.comment, opts.agentId);
      if (!result || !setHighlightResolved(session.id, opts.highlightId, true, true)) throw new Error(`highlight ${opts.highlightId} not found`);
      if (opts.agentId) markRead(session.id, opts.highlightId, opts.agentId);
      emit({ ok: true, highlightId: opts.highlightId, status: "completed" });
    } else if (opts.command === "close-session") {
      emit(closeSession(session.id));
    } else if (opts.command === "reopen-session") {
      const db = openDb();
      try { db.prepare("UPDATE sessions SET state = 'active', closed_at = NULL WHERE id = ?").run(session.id); } finally { db.close(); }
      emit({ ok: true, sessionId: session.id, state: "active" });
    }
    process.exit(0);
  }

  if (opts.files.length === 0) throw new Error("Usage: spotlight-md --auto FILE.md | spotlight-md list-highlights --session-id ID");
  const inputPath = resolve(opts.files[0]);
  statSync(inputPath);
  if (opts.auto) {
    const session = getOrCreateSession(inputPath, opts.newSession);
    if (opts.json) console.log(JSON.stringify({ sessionId: session.id, path: session.path, resumed: session.resumed, url: `http://localhost:${opts.port}` }));
    serveAuto(inputPath, opts, session);
  } else {
    const outputPath = resolve(opts.output || inputPath.replace(/\.md$/i, ".html"));
    writeStatic(inputPath, outputPath);
  }
} catch (e) {
  console.error(`spotlight-md: ${e.message}`);
  process.exit(1);
}
