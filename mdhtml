function themeRoot(themeName) {
  const t = THEMES[themeName] || THEMES["github-dark"];
  const vars = Object.entries(t)
    .map(([k, v]) => `  ${k}: ${v};`)
    .join("\n");
  return `:root {\n${vars}\n  --sidebar-w: 300px;\n}`;
}

