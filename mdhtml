function renderFile(inputPath) {
  const raw = readFileSync(inputPath, "utf-8");

  // Extract frontmatter (bold-label metadata block after H1)
  const { frontmatter, md: mdNoFrontmatter } = extractFrontmatter(raw);

  // Strip trailing whitespace per line so paragraphs reflow
  const reflowed = mdNoFrontmatter
    .split("\n")
    .map((l) => l.replace(/\s+$/, ""))
    .join("\n");

  const result = spawnSync("pandoc", [
    "--from", "markdown+autolink_bare_uris",
    "--to", "html5",
    "--no-highlight",
    "--wrap=none",
  ], { input: reflowed, encoding: "utf-8" });

  if (result.status !== 0) {
    const err = result.stderr || result.stdout || "unknown pandoc error";
    throw new Error(`pandoc failed: ${err}`);
  }

  const body = result.stdout.trim();

  // Build frontmatter HTML
  const frontmatterHtml = frontmatter ? buildFrontmatterHtml(frontmatter) : "";

  // Build TOC from rendered headings
  const tocEntries = extractToc(body);
  const tocHtml = buildTocHtml(tocEntries);

  // Prefer the document's H1 as the page/tab title so tabs are findable;
  // fall back to the filename when there's no heading to use.
  const h1Entry = tocEntries.find((e) => e.level === 1);
  const title = h1Entry ? h1Entry.text : basename(inputPath, extname(inputPath));

  return { title, html: body, frontmatterHtml, tocHtml };
}

function writeStatic(inputPath, outputPath) {
  const { title, html, frontmatterHtml, tocHtml } = renderFile(inputPath);
  const full = buildHtml(title, html, frontmatterHtml, tocHtml, false, opts.theme);
  writeFileSync(outputPath, full);
  console.log(`  wrote ${outputPath}`);
}

function serveAuto(inputPath, opts, session) {
  const report = opts.json ? console.error : console.log;
  let currentHtml = "";
  let currentTitle = "";
  let currentFrontmatter = "";
  let currentToc = "";
  let mtime = 0;
  const sseClients = [];

  function rebuild() {
    try {
      const { title, html, frontmatterHtml, tocHtml } = renderFile(inputPath);
      currentTitle = title;
      currentHtml = html;
      currentFrontmatter = frontmatterHtml;
      currentToc = tocHtml;
      mtime = statSync(inputPath).mtimeMs;
      report(`  [${new Date().toLocaleTimeString()}] rendered ${inputPath}`);
    } catch (e) {
      console.error("  render error:", e.message);
    }
  }

  rebuild();

  // Also write a static file alongside
  const outputPath = opts.output || inputPath.replace(/\.md$/i, ".html");
  function writeStaticCopy() {
    try {
      writeFileSync(outputPath, buildHtml(currentTitle, currentHtml, currentFrontmatter, currentToc, false, opts.theme));
    } catch (e) { /* ignore */ }
  }
  writeStaticCopy();

  function broadcastHighlights() {
    for (const client of sseClients) {
      client.write("event: highlights-updated\ndata: {}\n\n");
    }
  }

  function readBody(req) {
    return new Promise((resolve) => {
      let data = "";
      req.on("data", (chunk) => (data += chunk));
      req.on("end", () => resolve(data));
    });
  }

  const server = createServer((req, res) => {
    const pathname = new URL(req.url || "/", "http://localhost").pathname;

    // SSE channel
    if (pathname === "/__reload__") {
      res.writeHead(200, {
        "Content-Type": "text/event-stream",
        "Cache-Control": "no-cache",
        Connection: "keep-alive",
      });
      res.write("retry: 2000\n\n");
      sseClients.push(res);
      req.on("close", () => {
        const idx = sseClients.indexOf(res);
        if (idx !== -1) sseClients.splice(idx, 1);
      });
      return;
    }

    // Highlight REST API
    if (pathname === "/__session__" && req.method === "GET") {
      res.writeHead(200, { "Content-Type": "application/json", "Cache-Control": "no-store" });
      res.end(JSON.stringify({ id: session.id, path: session.path, state: session.state }));
      return;
    }
    if (pathname === "/__highlights__" && req.method === "GET") {
      const hls = loadHighlights(session.id);
      res.writeHead(200, { "Content-Type": "application/json", "Cache-Control": "no-store" });
      res.end(JSON.stringify(hls));
      return;
    }
    if (pathname === "/__highlights__" && req.method === "POST") {
      readBody(req).then((body) => {
        try {
          const data = JSON.parse(body);
          if (!data.text || data.text.trim().length < 2) {
            res.writeHead(400, { "Content-Type": "application/json" });
            res.end(JSON.stringify({ error: "text required" }));
            return;
          }
          const hl = addHighlight(session.id, data);
          res.writeHead(201, {
            "Content-Type": "application/json",
            Location: `/__highlights__/${hl.id}`,
          });
          res.end(JSON.stringify(hl));
          broadcastHighlights();
        } catch (e) {
          res.writeHead(500, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: e.message }));
        }
      });
      return;
    }
    const hlIdMatch = pathname.match(/^\/__highlights__\/([^/]+)$/);
    if (hlIdMatch && req.method === "DELETE") {
      const id = hlIdMatch[1];
      const removed = setHighlightResolved(session.id, id, true, true);
      if (removed) {
        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ ok: true, id }));
        broadcastHighlights();
      } else {
        res.writeHead(404, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: "not found" }));
      }
      return;
    }
    if (hlIdMatch && req.method === "PATCH") {
      const id = hlIdMatch[1];
      readBody(req).then((body) => {
        try {
          JSON.parse(body);
          res.writeHead(410, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: "editing an initial note is not supported" }));
        } catch (e) {
          res.writeHead(500, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: e.message }));
        }
      });
      return;
    }

    // Message endpoint: POST /__highlights__/:id/messages  (author defaults to "ai")
    const msgMatch = pathname.match(/^\/__highlights__\/([^/]+)\/messages$/);
    if (msgMatch && req.method === "POST") {
      const id = msgMatch[1];
      readBody(req).then((body) => {
        try {
          const data = JSON.parse(body);
          if (!data.text || data.text.trim().length < 1) {
            res.writeHead(400, { "Content-Type": "application/json" });
            res.end(JSON.stringify({ error: "text required" }));
            return;
          }
          const author = data.author || "ai";
          const result = addHighlightMessage(session.id, id, author, data.text.trim(), data.agentId || null);
          if (result) {
            res.writeHead(200, { "Content-Type": "application/json" });
            res.end(JSON.stringify(result));
            broadcastHighlights();
          } else {
            res.writeHead(404, { "Content-Type": "application/json" });
            res.end(JSON.stringify({ error: "highlight not found" }));
          }
        } catch (e) {
          res.writeHead(500, { "Content-Type": "application/json" });
          res.end(JSON.stringify({ error: e.message }));
        }
      });
      return;
    }

    // Resolve endpoint: PATCH /__highlights__/:id/resolve
    const resolveMatch = pathname.match(/^\/__highlights__\/([^/]+)\/resolve$/);
    if (resolveMatch && req.method === "PATCH") {
      const id = resolveMatch[1];
      const hl = setHighlightResolved(session.id, id, true);
      if (hl) {
        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify(hl));
        broadcastHighlights();
      } else {
        res.writeHead(404, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: "not found" }));
      }
      return;
    }

    // Unresolve endpoint: PATCH /__highlights__/:id/unresolve
    const unresolveMatch = pathname.match(/^\/__highlights__\/([^/]+)\/unresolve$/);
    if (unresolveMatch && req.method === "PATCH") {
      const id = unresolveMatch[1];
      const hl = setHighlightResolved(session.id, id, false);
      if (hl) {
        res.writeHead(200, { "Content-Type": "application/json" });
        res.end(JSON.stringify(hl));
        broadcastHighlights();
      } else {
        res.writeHead(404, { "Content-Type": "application/json" });
        res.end(JSON.stringify({ error: "not found" }));
      }
      return;
    }

    if (pathname === "/__mtime__") {
      res.writeHead(200, { "Content-Type": "text/plain" });
      res.end(String(mtime));
      return;
    }
    // Serve the rendered page
    res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
    res.end(buildHtml(currentTitle, currentHtml, currentFrontmatter, currentToc, true, opts.theme));
  });

  server.listen(opts.port, () => {
    const url = `http://localhost:${opts.port}`;
    report(`\n  spotlight-md serving ${inputPath}`);
    report(`  session: ${session.id}${session.resumed ? " (resumed)" : ""}`);
    report(`  → ${url}\n`);
    if (opts.open) {
      try {
        spawn("open", [url], { stdio: "ignore", detached: true }).unref();
      } catch (e) { /* ignore */ }
    }
  });

  // Watch the file (polling for reliability on macOS/network drives)
  let debounceTimer = null;
  watchFile(inputPath, { interval: 500 }, (curr) => {
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      rebuild();
      writeStaticCopy();
      // Notify all connected browsers
      for (const client of sseClients) {
        client.write("event: reload\ndata: {}\n\n");
      }
    }, 150);
  });

  report("  watching for changes…  (Ctrl-C to stop)\n");

  process.on("SIGINT", () => {
    unwatchFile(inputPath);
    for (const c of sseClients) c.end();
    server.close();
    report("\n  stopped.");
    process.exit(0);
  });
}

