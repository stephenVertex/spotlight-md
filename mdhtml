#!/usr/bin/env node
// mdhtml — render markdown to a dark-themed HTML page with optional live reload.
//   mdhtml file.md              → writes file.html
//   mdhtml --auto file.md       → serves + watches + live-reloads in browser
//   mdhtml -o out.html file.md  → specify output path
//   mdhtml --port 4040 --auto file.md
// Zero dependencies. Node 18+.

import { readFileSync, writeFileSync, watchFile, unwatchFile, statSync, mkdirSync, realpathSync, unlinkSync, chmodSync } from "node:fs";
import { resolve, dirname, basename, extname, join } from "node:path";
import { homedir } from "node:os";
import { createServer } from "node:http";
import { spawn, spawnSync } from "node:child_process";
import { randomBytes } from "node:crypto";
import { DatabaseSync } from "node:sqlite";

const VERSION = readFileSync(new URL("./VERSION", import.meta.url), "utf8").trim();

// ── CLI parsing ────────────────────────────────────────────────────────────
function parseArgs(argv) {
  const opts = { auto: false, daemon: false, port: 7231, output: null, open: true, theme: "github-dark", prime: false, files: [], command: null, sessionId: null, highlightId: null, agentId: null, comment: null, anchor: null, replacement: null, wait: false, release: false, json: false, newSession: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "prime") opts.prime = true;
    else if (["status", "stop", "list-highlights", "get-highlight-details", "get-new-comments", "ai-agent-mark-read", "add-comment", "suggest-edit", "list-suggestions", "ai-agent-claim", "ai-agent-mark-as-completed", "close-session", "reopen-session"].includes(a)) opts.command = a;
    else if (a === "--auto" || a === "-a") opts.auto = true;
    else if (a === "--daemon") opts.daemon = true;
    else if (a === "--port" || a === "-p") opts.port = parseInt(argv[++i], 10);
    else if (a === "--output" || a === "-o") opts.output = argv[++i];
    else if (a === "--no-open") opts.open = false;
    else if (a === "--theme" || a === "-t") opts.theme = argv[++i];
    else if (a === "--session-id") opts.sessionId = argv[++i];
    else if (a.startsWith("--session-id=")) opts.sessionId = a.slice(13);
    else if (a === "--highlight-id") opts.highlightId = argv[++i];
    else if (a.startsWith("--highlight-id=")) opts.highlightId = a.slice(15);
    else if (a === "--agent-id") opts.agentId = argv[++i];
    else if (a.startsWith("--agent-id=")) opts.agentId = a.slice(11);
    else if (a === "--comment") opts.comment = argv[++i];
    else if (a.startsWith("--comment=")) opts.comment = a.slice(10);
    else if (a === "--anchor") opts.anchor = argv[++i];
    else if (a.startsWith("--anchor=")) opts.anchor = a.slice(9);
    else if (a === "--replacement") opts.replacement = argv[++i];
    else if (a.startsWith("--replacement=")) opts.replacement = a.slice(14);
    else if (a === "--wait") opts.wait = true;
    else if (a === "--release") opts.release = true;
    else if (a === "--json") opts.json = true;
    else if (a === "--new-session") opts.newSession = true;
    else if (a === "--version" || a === "-V") {
      console.log(`spotlight-md ${VERSION}`);
      process.exit(0);
    }
    else if (a === "--help" || a === "-h") {
      console.log(`spotlight-md — Markdown review service

Usage:
  spotlight-md --auto [--json] [--new-session] FILE.md
  spotlight-md status [--port NUM] [--json]
  spotlight-md stop [--port NUM] [--json]
  spotlight-md list-highlights --session-id ID [--json]
  spotlight-md get-highlight-details --session-id ID --highlight-id ID [--json]
  spotlight-md get-new-comments --session-id ID --agent-id ID [--wait] [--json]
  spotlight-md ai-agent-mark-read --session-id ID --highlight-id ID --agent-id ID
  spotlight-md add-comment --session-id ID --highlight-id ID --comment TEXT [--agent-id ID]
  spotlight-md suggest-edit --session-id ID --highlight-id ID --anchor TEXT --replacement TEXT [--comment TEXT] [--agent-id ID]
  spotlight-md list-suggestions --session-id ID [--highlight-id ID] [--json]
  spotlight-md ai-agent-claim --session-id ID --highlight-id ID [--release] [--agent-id ID]
  spotlight-md ai-agent-mark-as-completed --session-id ID --highlight-id ID --comment TEXT [--agent-id ID]
  spotlight-md close-session --session-id ID
  spotlight-md reopen-session --session-id ID

Sessions and annotations live in ~/.config/spotlight-md/global-highlights-db.db.
--auto resumes the document's active session unless --new-session is set.
Use --json for stable machine-readable output.`);
      process.exit(0);
    } else if (a.startsWith("-")) {
      console.error(`Unknown option: ${a}`);
      process.exit(1);
    } else {
      opts.files.push(a);
    }
  }
  return opts;
}

// ── Highlight storage (SQLite) ─────────────────────────────────────────────
function dbFilePath() {
  const configDir = process.env.SPOTLIGHT_MD_CONFIG_DIR || join(homedir(), ".config", "spotlight-md");
  mkdirSync(configDir, { recursive: true, mode: 0o700 });
  return join(configDir, "global-highlights-db.db");
}

function openDb() {
  const dbPath = dbFilePath();
  const db = new DatabaseSync(dbPath);
  // Set busy_timeout FIRST so the journal_mode pragma (which needs a brief lock)
  // waits for a concurrent writer instead of failing immediately with
  // SQLITE_BUSY under contention.
  db.exec("PRAGMA busy_timeout = 5000");
  db.exec("PRAGMA journal_mode = WAL");
  db.exec(`
    CREATE TABLE IF NOT EXISTS sessions (
      id TEXT PRIMARY KEY, document_path TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'active',
      initial_content TEXT NOT NULL, created_at TEXT NOT NULL, closed_at TEXT, close_summary TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_sessions_document_active ON sessions(document_path, state, created_at);
    CREATE TABLE IF NOT EXISTS highlights (
      id TEXT PRIMARY KEY,
      session_id TEXT NOT NULL,
      text TEXT NOT NULL,
      section_id TEXT,
      section_title TEXT,
      resolved INTEGER DEFAULT 0,
      completed INTEGER DEFAULT 0,
      created_at TEXT NOT NULL,
      completed_at TEXT
    );
    CREATE TABLE IF NOT EXISTS messages (
      id TEXT PRIMARY KEY,
      highlight_id TEXT NOT NULL,
      author TEXT NOT NULL,
      agent_id TEXT,
      text TEXT NOT NULL,
      created_at TEXT NOT NULL,
      seq INTEGER NOT NULL,
      FOREIGN KEY (highlight_id) REFERENCES highlights(id)
    );
    CREATE INDEX IF NOT EXISTS idx_messages_highlight ON messages(highlight_id, seq);
    CREATE TABLE IF NOT EXISTS agent_reads (
      session_id TEXT NOT NULL, agent_id TEXT NOT NULL, highlight_id TEXT NOT NULL,
      last_read_seq INTEGER NOT NULL DEFAULT -1, read_at TEXT NOT NULL,
      PRIMARY KEY (session_id, agent_id, highlight_id)
    );
    CREATE TABLE IF NOT EXISTS suggestions (
      id TEXT PRIMARY KEY,
      session_id TEXT NOT NULL,
      highlight_id TEXT,
      anchor TEXT NOT NULL,
      replacement TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'pending',
      agent_id TEXT,
      created_at TEXT NOT NULL,
      resolved_at TEXT
    );
    CREATE INDEX IF NOT EXISTS idx_suggestions_session ON suggestions(session_id, status);
    CREATE TABLE IF NOT EXISTS ai_activity (
      session_id TEXT NOT NULL,
      highlight_id TEXT NOT NULL,
      agent_id TEXT,
      state TEXT NOT NULL,
      updated_at TEXT NOT NULL,
      PRIMARY KEY (session_id, highlight_id)
    );
  `);
  // Migration: highlights may be text-anchored (default) or 'document'-scoped
  // whole-document directives sent from the composer. Add the column if missing.
  try { db.exec("ALTER TABLE highlights ADD COLUMN scope TEXT NOT NULL DEFAULT 'text'"); }
  catch (e) { /* column already exists */ }
  return db;
}

function genId(prefix) { return prefix + randomBytes(5).toString("hex"); }

function getOrCreateSession(inputPath, newSession = false) {
  const canonical = resolve(inputPath);
  const db = openDb();
  try {
    if (!newSession) {
      const existing = db.prepare("SELECT id, document_path, state, created_at FROM sessions WHERE document_path = ? AND state = 'active' ORDER BY created_at DESC LIMIT 1").get(canonical);
      if (existing) return { id: existing.id, path: existing.document_path, state: existing.state, createdAt: existing.created_at, resumed: true };
    }
    const id = genId("sp-");
    const now = new Date().toISOString();
    db.prepare("INSERT INTO sessions (id, document_path, initial_content, created_at) VALUES (?, ?, ?, ?)").run(id, canonical, readFileSync(canonical, "utf8"), now);
    return { id, path: canonical, state: "active", createdAt: now, resumed: false };
  } finally { db.close(); }
}

function getSession(sessionId) {
  const db = openDb();
  try {
    const row = db.prepare("SELECT id, document_path, state, initial_content, created_at, closed_at, close_summary FROM sessions WHERE id = ?").get(sessionId);
    return row ? { id: row.id, path: row.document_path, state: row.state, initialContent: row.initial_content, createdAt: row.created_at, closedAt: row.closed_at, closeSummary: row.close_summary } : null;
  } finally { db.close(); }
}

function requireActiveSession(sessionId) {
  const session = getSession(sessionId);
  if (!session) throw new Error(`session ${sessionId} not found`);
  if (session.state !== "active") throw new Error(`session ${sessionId} is closed; reopen it before changing highlights`);
  return session;
}

function loadHighlights(sessionId) {
  const db = openDb();
  try {
    const rows = db.prepare(`
      SELECT id, text, section_id, section_title, resolved, completed, created_at, completed_at, scope
      FROM highlights WHERE session_id = ? ORDER BY created_at
    `).all(sessionId);
    return rows.map((r) => {
      const msgs = db.prepare(`
        SELECT id, author, agent_id, text, created_at, seq FROM messages
        WHERE highlight_id = ? ORDER BY seq
      `).all(r.id);
      return {
        id: r.id,
        text: r.text,
        sectionId: r.section_id,
        sectionTitle: r.section_title,
        scope: r.scope || "text",
        resolved: !!r.resolved,
        completed: !!r.completed,
        createdAt: r.created_at,
        completedAt: r.completed_at || undefined,
        messages: msgs.map((m) => ({ id: m.id, author: m.author, agentId: m.agent_id || undefined, text: m.text, createdAt: m.created_at, seq: m.seq })),
      };
    });
  } finally {
    db.close();
  }
}

function addHighlight(sessionId, data) {
  requireActiveSession(sessionId);
  const db = openDb();
  try {
    const scope = data.scope === "document" ? "document" : "text";
    const id = genId(scope === "document" ? "dm-" : "hl-");
    const now = new Date().toISOString();
    db.prepare(`
      INSERT INTO highlights (id, session_id, text, section_id, section_title, resolved, completed, created_at, scope)
      VALUES (?, ?, ?, ?, ?, 0, 0, ?, ?)
    `).run(id, sessionId, data.text, data.sectionId || null, data.sectionTitle || null, now, scope);
    let messages = [];
    if (data.note) {
      const msgId = "msg-" + randomBytes(3).toString("hex");
      db.prepare(`
        INSERT INTO messages (id, highlight_id, author, text, created_at, seq)
        VALUES (?, ?, 'human', ?, ?, 0)
      `).run(msgId, id, data.note, now);
      messages = [{ id: msgId, author: "human", text: data.note, createdAt: now, seq: 0 }];
    }
    return { id, text: data.text, sectionId: data.sectionId, sectionTitle: data.sectionTitle, scope, resolved: false, completed: false, createdAt: now, messages };
  } finally {
    db.close();
  }
}

function addHighlightMessage(sessionId, id, author, text, agentId = null) {
  requireActiveSession(sessionId);
  const db = openDb();
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ? AND session_id = ?").get(id, sessionId);
    if (!existing) return null;
    const seq = db.prepare("SELECT COALESCE(MAX(seq), -1) + 1 as next FROM messages WHERE highlight_id = ?").get(id);
    const msgId = genId("msg-");
    const now = new Date().toISOString();
    db.prepare("INSERT INTO messages (id, highlight_id, author, agent_id, text, created_at, seq) VALUES (?, ?, ?, ?, ?, ?, ?)").run(msgId, id, author, agentId, text, now, seq.next);
    const msg = { id: msgId, author, agentId: agentId || undefined, text, createdAt: now, seq: seq.next };
    const hl = loadHighlights(sessionId).find((h) => h.id === id);
    return { highlight: hl, message: msg };
  } finally {
    db.close();
  }
}

function setHighlightResolved(sessionId, id, resolved, completed = false) {
  requireActiveSession(sessionId);
  const db = openDb();
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ? AND session_id = ?").get(id, sessionId);
    if (!existing) return null;
    db.prepare("UPDATE highlights SET resolved = ?, completed = ?, completed_at = ? WHERE id = ?").run(resolved ? 1 : 0, completed ? 1 : 0, completed ? new Date().toISOString() : null, id);
    return loadHighlights(sessionId).find((h) => h.id === id) || null;
  } finally {
    db.close();
  }
}

function suggestionRow(r) {
  return {
    id: r.id,
    highlightId: r.highlight_id || undefined,
    anchor: r.anchor,
    replacement: r.replacement,
    status: r.status,
    agentId: r.agent_id || undefined,
    createdAt: r.created_at,
    resolvedAt: r.resolved_at || undefined,
  };
}

function loadSuggestions(sessionId, { status, highlightId } = {}) {
  const db = openDb();
  try {
    let sql = "SELECT id, highlight_id, anchor, replacement, status, agent_id, created_at, resolved_at FROM suggestions WHERE session_id = ?";
    const params = [sessionId];
    if (status) { sql += " AND status = ?"; params.push(status); }
    if (highlightId) { sql += " AND highlight_id = ?"; params.push(highlightId); }
    sql += " ORDER BY created_at";
    return db.prepare(sql).all(...params).map(suggestionRow);
  } finally { db.close(); }
}

function getSuggestion(sessionId, id) {
  const db = openDb();
  try {
    const r = db.prepare("SELECT id, highlight_id, anchor, replacement, status, agent_id, created_at, resolved_at FROM suggestions WHERE id = ? AND session_id = ?").get(id, sessionId);
    return r ? suggestionRow(r) : null;
  } finally { db.close(); }
}

function addSuggestion(sessionId, { highlightId, anchor, replacement, agentId }) {
  requireActiveSession(sessionId);
  const db = openDb();
  try {
    if (highlightId) {
      const hl = db.prepare("SELECT id FROM highlights WHERE id = ? AND session_id = ?").get(highlightId, sessionId);
      if (!hl) throw new Error(`highlight ${highlightId} not found`);
    }
    const id = genId("sg-");
    const now = new Date().toISOString();
    db.prepare(`
      INSERT INTO suggestions (id, session_id, highlight_id, anchor, replacement, status, agent_id, created_at)
      VALUES (?, ?, ?, ?, ?, 'pending', ?, ?)
    `).run(id, sessionId, highlightId || null, anchor, replacement, agentId || null, now);
    return { id, highlightId: highlightId || undefined, anchor, replacement, status: "pending", agentId: agentId || undefined, createdAt: now };
  } finally { db.close(); }
}

function setSuggestionStatus(sessionId, id, status) {
  requireActiveSession(sessionId);
  const db = openDb();
  try {
    const existing = db.prepare("SELECT id FROM suggestions WHERE id = ? AND session_id = ?").get(id, sessionId);
    if (!existing) return null;
    db.prepare("UPDATE suggestions SET status = ?, resolved_at = ? WHERE id = ?").run(status, status === "pending" ? null : new Date().toISOString(), id);
    return getSuggestion(sessionId, id);
  } finally { db.close(); }
}

// Locate an anchor within the raw markdown. Tries an exact match first, then
// falls back to a whitespace-flexible match so an anchor copied from the
// rendered text (where prose is reflowed onto one line) still matches source
// that is hard-wrapped across several lines. Returns { index, length } or null.
function findAnchor(raw, anchor) {
  const exact = raw.indexOf(anchor);
  if (exact !== -1) return { index: exact, length: anchor.length };
  const trimmed = anchor.trim();
  if (!trimmed) return null;
  // Escape regex metacharacters, then let any run of whitespace in the anchor
  // match any run of whitespace (spaces, newlines) in the source.
  const pattern = trimmed
    .replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
    .replace(/\s+/g, "\\s+");
  const m = new RegExp(pattern).exec(raw);
  return m ? { index: m.index, length: m[0].length } : null;
}

// Accept a suggestion: splice its anchor→replacement into the raw markdown of
// the session's document (first occurrence), then mark it accepted. Returns
// { suggestion, applied: true } on success, or { error } describing why the
// splice could not be made so the caller can surface it.
function acceptSuggestion(sessionId, id) {
  const session = requireActiveSession(sessionId);
  const suggestion = getSuggestion(sessionId, id);
  if (!suggestion) return { error: "not found" };
  if (suggestion.status !== "pending") return { error: `suggestion already ${suggestion.status}` };
  let raw;
  try { raw = readFileSync(session.path, "utf8"); }
  catch (e) { return { error: `cannot read document: ${e.message}` }; }
  const found = findAnchor(raw, suggestion.anchor);
  if (!found) {
    return { error: "anchor text not found in the document; it may have changed since the suggestion was made" };
  }
  const updated = raw.slice(0, found.index) + suggestion.replacement + raw.slice(found.index + found.length);
  try { writeFileSync(session.path, updated); }
  catch (e) { return { error: `cannot write document: ${e.message}` }; }
  const applied = setSuggestionStatus(sessionId, id, "accepted");
  return { suggestion: applied, applied: true };
}

// AI activity: an agent "claims" a highlight while it works on it (so the
// browser can pulse it), and the claim is released when it responds.
function setAiClaim(sessionId, highlightId, agentId, claimed) {
  const db = openDb();
  try {
    const existing = db.prepare("SELECT id FROM highlights WHERE id = ? AND session_id = ?").get(highlightId, sessionId);
    if (!existing) return false;
    if (claimed) {
      db.prepare("INSERT INTO ai_activity (session_id, highlight_id, agent_id, state, updated_at) VALUES (?, ?, ?, 'thinking', ?) ON CONFLICT(session_id, highlight_id) DO UPDATE SET agent_id = excluded.agent_id, state = 'thinking', updated_at = excluded.updated_at").run(sessionId, highlightId, agentId || null, new Date().toISOString());
    } else {
      db.prepare("DELETE FROM ai_activity WHERE session_id = ? AND highlight_id = ?").run(sessionId, highlightId);
    }
    return true;
  } finally { db.close(); }
}

// Release any claim on a highlight (used automatically when the agent responds).
function releaseAiClaim(sessionId, highlightId) {
  const db = openDb();
  try { db.prepare("DELETE FROM ai_activity WHERE session_id = ? AND highlight_id = ?").run(sessionId, highlightId); }
  finally { db.close(); }
}

function loadAiActivity(sessionId) {
  const db = openDb();
  try {
    const rows = db.prepare("SELECT highlight_id, state FROM ai_activity WHERE session_id = ?").all(sessionId);
    return new Map(rows.map((r) => [r.highlight_id, r.state]));
  } finally { db.close(); }
}

// Attach pending suggestions and AI activity to highlights for the browser.
function loadHighlightsWithSuggestions(sessionId) {
  const highlights = loadHighlights(sessionId);
  const pending = loadSuggestions(sessionId, { status: "pending" });
  const activity = loadAiActivity(sessionId);
  const byHl = new Map();
  for (const s of pending) {
    if (!s.highlightId) continue;
    if (!byHl.has(s.highlightId)) byHl.set(s.highlightId, []);
    byHl.get(s.highlightId).push(s);
  }
  return highlights.map((h) => ({ ...h, suggestions: byHl.get(h.id) || [], aiState: activity.get(h.id) || null }));
}

// LaTeX-style numbered outline of the document's ## / ### headings, derived
// live from the current source. The UI numbers headings with CSS (display
// only), so agents can't see the numbers in the source; this gives them the
// exact mapping (e.g. "2.1" -> "Where to eat") to resolve human references.
function numberedSectionOutline(docPath) {
  let raw;
  try { raw = readFileSync(docPath, "utf8"); }
  catch (e) { return []; }
  const lines = raw.split("\n");
  const out = [];
  let major = 0, minor = 0, inFence = false;
  for (const line of lines) {
    if (/^\s*(```|~~~)/.test(line)) { inFence = !inFence; continue; }
    if (inFence) continue;
    const m = line.match(/^(#{2,3})\s+(.*\S)\s*$/);
    if (!m) continue;
    const level = m[1].length;
    const title = m[2].replace(/\s+#+\s*$/, "").trim();
    if (level === 2) { major++; minor = 0; out.push({ number: String(major), level: 2, title }); }
    else { minor++; out.push({ number: `${major}.${minor}`, level: 3, title }); }
  }
  return out;
}

// Attach a live section outline to whole-document directives so the agent can
// resolve "section 2.1" style references without counting headings itself.
function withCurrentToc(item, docPath) {
  if (item && item.scope === "document") return { ...item, currentToc: numberedSectionOutline(docPath) };
  return item;
}

function markRead(sessionId, id, agentId) {
  const db = openDb();
  try {
    const row = db.prepare("SELECT COALESCE(MAX(m.seq), -1) AS last_seq FROM highlights h LEFT JOIN messages m ON m.highlight_id = h.id WHERE h.id = ? AND h.session_id = ?").get(id, sessionId);
    if (!row) return false;
    db.prepare("INSERT INTO agent_reads (session_id, agent_id, highlight_id, last_read_seq, read_at) VALUES (?, ?, ?, ?, ?) ON CONFLICT(session_id, agent_id, highlight_id) DO UPDATE SET last_read_seq = excluded.last_read_seq, read_at = excluded.read_at").run(sessionId, agentId, id, row.last_seq, new Date().toISOString());
    return true;
  } finally { db.close(); }
}

function getUnread(sessionId, agentId) {
  const highlights = loadHighlights(sessionId);
  const db = openDb();
  try {
    const reads = new Map(db.prepare("SELECT highlight_id, last_read_seq FROM agent_reads WHERE session_id = ? AND agent_id = ?").all(sessionId, agentId).map((r) => [r.highlight_id, r.last_read_seq]));
    return highlights.filter((h) => !reads.has(h.id) || h.messages.some((m) => m.seq > reads.get(h.id)));
  } finally { db.close(); }
}

function renderCloseSummary(session, highlights, currentContent) {
  const open = highlights.filter((h) => !h.resolved && !h.completed).length;
  const resolved = highlights.filter((h) => h.resolved && !h.completed).length;
  const completed = highlights.filter((h) => h.completed).length;
  const lines = [`# Review session ${session.id}`, "", `Document: ${session.path}`, `Started: ${session.createdAt}`, `Closed: ${new Date().toISOString()}`, `Highlights: ${highlights.length} total · ${open} open · ${resolved} resolved · ${completed} completed`, "", "## Document changes"];
  if (currentContent === session.initialContent) lines.push("No document changes detected.");
  else {
    const before = session.initialContent.split("\n");
    const after = currentContent.split("\n");
    let start = 0;
    while (start < before.length && start < after.length && before[start] === after[start]) start++;
    let endBefore = before.length - 1, endAfter = after.length - 1;
    while (endBefore >= start && endAfter >= start && before[endBefore] === after[endAfter]) { endBefore--; endAfter--; }
    lines.push(`Changed lines ${start + 1}–${Math.max(start + 1, endBefore + 1)} (baseline) → ${start + 1}–${Math.max(start + 1, endAfter + 1)} (current):`);
    for (const line of before.slice(start, endBefore + 1).slice(0, 80)) lines.push(`- ${line}`);
    for (const line of after.slice(start, endAfter + 1).slice(0, 80)) lines.push(`+ ${line}`);
  }
  lines.push("", "## Review trail");
  for (const h of highlights) {
    const status = h.completed ? "completed" : h.resolved ? "resolved" : "open";
    lines.push(`- ${h.id} (${status}): ${h.text.slice(0, 160)}`);
    for (const m of h.messages) lines.push(`  - ${m.author}${m.agentId ? ` (${m.agentId})` : ""}: ${m.text}`);
  }
  return lines.join("\n") + "\n";
}

function closeSession(sessionId) {
  const session = getSession(sessionId);
  if (!session) return null;
  const summary = renderCloseSummary(session, loadHighlights(sessionId), readFileSync(session.path, "utf8"));
  const db = openDb();
  try { db.prepare("UPDATE sessions SET state = 'closed', closed_at = ?, close_summary = ? WHERE id = ?").run(new Date().toISOString(), summary, sessionId); }
  finally { db.close(); }
  return summary;
}

// ── Markdown helpers ───────────────────────────────────────────────────────
function escapeHtml(s) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

// ── TOC extraction ─────────────────────────────────────────────────────────
function extractToc(html) {
  const re = /<h([123])\s+id="([^"]+)"[^>]*>(.*?)<\/h\1>/gi;
  const entries = [];
  let m;
  while ((m = re.exec(html)) !== null) {
    entries.push({
      level: parseInt(m[1]),
      id: m[2],
      text: m[3].replace(/<[^>]+>/g, ""),
    });
  }
  return entries;
}

function buildTocHtml(entries) {
  if (entries.length === 0) return "";
  const minLevel = Math.min(...entries.map((e) => e.level));
  let html = "";
  for (const e of entries) {
    const indent = (e.level - minLevel) * 16;
    html += `<a href="#${e.id}" class="toc-link toc-l${e.level}" data-target="${e.id}" style="padding-left:${12 + indent}px"><span>${escapeHtml(e.text)}</span></a>\n`;
  }
  return html;
}

// ── Frontmatter extraction ─────────────────────────────────────────────────
function extractFrontmatter(rawMd) {
  const lines = rawMd.split("\n");
  let h1Idx = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^#\s+/.test(lines[i])) { h1Idx = i; break; }
  }
  if (h1Idx === -1) return { frontmatter: null, md: rawMd };

  // Collect non-blank lines after H1 until a blank line
  const blockStart = h1Idx + 1;
  // skip blank lines between H1 and content
  let idx = blockStart;
  while (idx < lines.length && lines[idx].trim() === "") idx++;
  const blockLines = [];
  while (idx < lines.length && lines[idx].trim() !== "") {
    blockLines.push(lines[idx]);
    idx++;
  }

  // Check if this block is frontmatter (multiple **Label:** entries)
  const labelRe = /^\*\*([^*]+):\*\*\s*(.*)$/;
  const matched = blockLines.filter((l) => labelRe.test(l)).length;
  if (matched < 2) return { frontmatter: null, md: rawMd };

  // Group lines into fields
  const fields = [];
  let current = null;
  for (const line of blockLines) {
    const m = line.match(labelRe);
    if (m) {
      if (current) fields.push(current);
      current = { label: m[1], value: m[2] };
    } else if (current) {
      current.value += " " + line.trim();
    }
  }
  if (current) fields.push(current);

  // Remove the frontmatter block from the markdown
  // Keep the H1 and everything after the blank line that ends the block
  const before = lines.slice(0, blockStart).join("\n");
  const after = lines.slice(idx).join("\n");
  const cleanedMd = before + "\n" + after;

  return { frontmatter: fields, md: cleanedMd };
}

function buildFrontmatterHtml(fields) {
  if (!fields || fields.length === 0) return "";
  let html = '<div class="frontmatter">\n';
  for (const f of fields) {
    html += `  <div class="fm-field"><span class="fm-label">${escapeHtml(f.label)}</span><span class="fm-value">${renderInlinePandoc(f.value)}</span></div>\n`;
  }
  html += "</div>";
  return html;
}

// Render a single inline string through pandoc for correctness
function renderInlinePandoc(text) {
  const result = spawnSync("pandoc", [
    "--from", "markdown+autolink_bare_uris",
    "--to", "html5",
    "--no-highlight",
  ], { input: text, encoding: "utf-8" });
  let out = result.stdout ? result.stdout.trim() : escapeHtml(text);
  // Strip wrapping <p> tags since this is inline content
  out = out.replace(/^<p>([\s\S]*)<\/p>$/, "$1");
  return out;
}

