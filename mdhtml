${sidebarHtml}
  <main class="content">
${frontmatterHtml ? frontmatterHtml + "\n" : ""}${bodyHtml}
  </main>
  <aside class="hl-panel" id="hl-panel">
    <div class="hl-panel-header">
      <div class="hl-panel-title">Highlights <span class="hl-panel-count" id="hl-panel-count"></span></div>
      <div class="hl-filter-btn active" id="hl-filter-btn">Hide resolved</div>
    </div>
    <div id="hl-panel-list"><div class="hl-panel-empty">Select text in the document to highlight passages.</div></div>
