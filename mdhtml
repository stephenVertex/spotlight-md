#!/usr/bin/env node
// mdhtml — render markdown to a dark-themed HTML page with optional live reload.
//   mdhtml file.md              → writes file.html
//   mdhtml --auto file.md       → serves + watches + live-reloads in browser
//   mdhtml -o out.html file.md  → specify output path
//   mdhtml --port 4040 --auto file.md
// Zero dependencies. Node 18+.

import { readFileSync, writeFileSync, watchFile, unwatchFile, statSync, existsSync } from "node:fs";
import { resolve, dirname, basename, extname, join } from "node:path";
import { createServer } from "node:http";
import { spawn, spawnSync } from "node:child_process";
import { randomBytes } from "node:crypto";

// ── CLI parsing ────────────────────────────────────────────────────────────
function parseArgs(argv) {
  const opts = { auto: false, port: 7231, output: null, open: true, theme: "github-dark", listHighlights: false, deleteHighlight: null, clearHighlights: false, prime: false, files: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "prime") opts.prime = true;
    else if (a === "--auto" || a === "-a") opts.auto = true;
    else if (a === "--port" || a === "-p") opts.port = parseInt(argv[++i], 10);
    else if (a === "--output" || a === "-o") opts.output = argv[++i];
    else if (a === "--no-open") opts.open = false;
    else if (a === "--theme" || a === "-t") opts.theme = argv[++i];
    else if (a === "--list-highlights") opts.listHighlights = true;
    else if (a === "--delete-highlight") opts.deleteHighlight = argv[++i];
    else if (a === "--clear-highlights") opts.clearHighlights = true;
    else if (a === "--help" || a === "-h") {
      console.log(`mdhtml — markdown → dark HTML with live reload

Usage:
  mdhtml file.md                Write file.html
  mdhtml --auto file.md         Serve, watch, and live-reload in browser
  mdhtml -o out.html file.md    Specify output path
  mdhtml --port 4040 --auto file.md
  mdhtml --no-open --auto file.md   Don't auto-open browser

Options:
  --auto, -a        Start local server + watch for live reload
  --port, -p NUM    Server port (default 7231)
  --output, -o PATH Output file path (default: <input>.html)
  --no-open         Don't open browser automatically
  --theme, -t NAME  Color scheme: github-dark (default) or dracula
  --list-highlights List all highlights for the file
  --delete-highlight ID  Delete a highlight by its ID
  --clear-highlights Remove all highlights for the file
  prime              Print instructions for AI agents on how to use this tool
  -h, --help        Show this help`);
      process.exit(0);
    } else if (a.startsWith("-")) {
      console.error(`Unknown option: ${a}`);
      process.exit(1);
    } else {
      opts.files.push(a);
    }
  }
  return opts;
}

// ── Highlight storage ──────────────────────────────────────────────────────
function highlightsFilePath(inputPath) {
  return inputPath.replace(/\.md$/i, ".highlights.json");
}

function loadHighlights(inputPath) {
  const hlPath = highlightsFilePath(inputPath);
  if (!existsSync(hlPath)) return [];
  try {
    return JSON.parse(readFileSync(hlPath, "utf-8"));
  } catch (e) {
    return [];
  }
}

function saveHighlights(inputPath, highlights) {
  writeFileSync(highlightsFilePath(inputPath), JSON.stringify(highlights, null, 2) + "\n");
}

function genHighlightId() {
  return "hl-" + randomBytes(3).toString("hex");
}

function addHighlight(inputPath, data) {
  const highlights = loadHighlights(inputPath);
  const hl = {
    id: genHighlightId(),
    text: data.text,
    sectionId: data.sectionId || null,
    sectionTitle: data.sectionTitle || null,
    note: data.note || "",
    createdAt: new Date().toISOString(),
  };
  highlights.push(hl);
  saveHighlights(inputPath, highlights);
  return hl;
}

function setHighlightNote(inputPath, id, note) {
  const highlights = loadHighlights(inputPath);
  const hl = highlights.find((h) => h.id === id);
  if (!hl) return null;
  hl.note = note;
  saveHighlights(inputPath, highlights);
  return hl;
}

function removeHighlight(inputPath, id) {
  const highlights = loadHighlights(inputPath);
  const idx = highlights.findIndex((h) => h.id === id);
  if (idx === -1) return false;
  highlights.splice(idx, 1);
  saveHighlights(inputPath, highlights);
  return true;
}

function printHighlights(inputPath) {
  const highlights = loadHighlights(inputPath);
  const fname = basename(inputPath);
  if (highlights.length === 0) {
    console.log(`  No highlights for ${fname}`);
    return;
  }
  console.log(`  Highlights for ${fname} (${highlights.length} total):\n`);
  for (const h of highlights) {
    const section = h.sectionId ? `§${h.sectionId}` : "§(top)";
    const preview = h.text.length > 80 ? h.text.slice(0, 77) + "…" : h.text;
    console.log(`  ${h.id}  ${section}`);
    console.log(`    "${preview}"`);
    if (h.note) {
      console.log(`    note: "${h.note}"`);
    }
    console.log(`    created: ${h.createdAt}\n`);
  }
}

// ── Markdown helpers ───────────────────────────────────────────────────────
function escapeHtml(s) {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

// ── TOC extraction ─────────────────────────────────────────────────────────
function extractToc(html) {
  const re = /<h([123])\s+id="([^"]+)"[^>]*>(.*?)<\/h\1>/gi;
  const entries = [];
  let m;
  while ((m = re.exec(html)) !== null) {
    entries.push({
      level: parseInt(m[1]),
      id: m[2],
      text: m[3].replace(/<[^>]+>/g, ""),
    });
  }
  return entries;
}

function buildTocHtml(entries) {
  if (entries.length === 0) return "";
  const minLevel = Math.min(...entries.map((e) => e.level));
  let html = "";
  for (const e of entries) {
    const indent = (e.level - minLevel) * 16;
    html += `<a href="#${e.id}" class="toc-link toc-l${e.level}" data-target="${e.id}" style="padding-left:${12 + indent}px"><span>${escapeHtml(e.text)}</span></a>\n`;
  }
  return html;
}

// ── Frontmatter extraction ─────────────────────────────────────────────────
function extractFrontmatter(rawMd) {
  const lines = rawMd.split("\n");
  let h1Idx = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^#\s+/.test(lines[i])) { h1Idx = i; break; }
  }
  if (h1Idx === -1) return { frontmatter: null, md: rawMd };

  // Collect non-blank lines after H1 until a blank line
  const blockStart = h1Idx + 1;
  // skip blank lines between H1 and content
  let idx = blockStart;
  while (idx < lines.length && lines[idx].trim() === "") idx++;
  const blockLines = [];
  while (idx < lines.length && lines[idx].trim() !== "") {
    blockLines.push(lines[idx]);
    idx++;
  }

  // Check if this block is frontmatter (multiple **Label:** entries)
  const labelRe = /^\*\*([^*]+):\*\*\s*(.*)$/;
  const matched = blockLines.filter((l) => labelRe.test(l)).length;
  if (matched < 2) return { frontmatter: null, md: rawMd };

  // Group lines into fields
  const fields = [];
  let current = null;
  for (const line of blockLines) {
    const m = line.match(labelRe);
    if (m) {
      if (current) fields.push(current);
      current = { label: m[1], value: m[2] };
    } else if (current) {
      current.value += " " + line.trim();
    }
  }
  if (current) fields.push(current);

  // Remove the frontmatter block from the markdown
  // Keep the H1 and everything after the blank line that ends the block
  const before = lines.slice(0, blockStart).join("\n");
  const after = lines.slice(idx).join("\n");
  const cleanedMd = before + "\n" + after;

  return { frontmatter: fields, md: cleanedMd };
}

function buildFrontmatterHtml(fields) {
  if (!fields || fields.length === 0) return "";
  let html = '<div class="frontmatter">\n';
  for (const f of fields) {
    html += `  <div class="fm-field"><span class="fm-label">${escapeHtml(f.label)}</span><span class="fm-value">${renderInlinePandoc(f.value)}</span></div>\n`;
  }
  html += "</div>";
  return html;
}

// Render a single inline string through pandoc for correctness
function renderInlinePandoc(text) {
  const result = spawnSync("pandoc", [
    "--from", "markdown+autolink_bare_uris",
    "--to", "html5",
    "--no-highlight",
  ], { input: text, encoding: "utf-8" });
  let out = result.stdout ? result.stdout.trim() : escapeHtml(text);
  // Strip wrapping <p> tags since this is inline content
  out = out.replace(/^<p>([\s\S]*)<\/p>$/, "$1");
  return out;
}

