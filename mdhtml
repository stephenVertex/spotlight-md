function buildRecentDocumentsHtml(recentDocuments, currentRoute) {
  if (!recentDocuments.length) return "";
  let html = '    <div class="sidebar-section-title">Recent documents</div>\n    <div class="recent-documents">\n';
  for (const document of recentDocuments) {
    const active = document.route === currentRoute;
    html += `      <a href="${escapeHtml(document.route)}" class="recent-document-link${active ? " active" : ""}"${active ? ' aria-current="page"' : ""}>\n`;
    html += `        <span class="recent-document-title">${escapeHtml(basename(document.path))}</span>\n`;
    html += `        <span class="recent-document-path">${escapeHtml(document.path)}</span>\n`;
    html += "      </a>\n";
  }
  return html + "    </div>\n";
}

