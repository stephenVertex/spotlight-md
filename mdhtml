// ── Main ───────────────────────────────────────────────────────────────────
function renderFile(inputPath) {
  const raw = readFileSync(inputPath, "utf-8");

  // Extract frontmatter (bold-label metadata block after H1)
  const { frontmatter, md: mdNoFrontmatter } = extractFrontmatter(raw);

  // Strip trailing whitespace per line so paragraphs reflow
  const reflowed = mdNoFrontmatter
    .split("\n")
    .map((l) => l.replace(/\s+$/, ""))
    .join("\n");

  const result = spawnSync("pandoc", [
    "--from", "markdown+autolink_bare_uris",
    "--to", "html5",
    "--no-highlight",
    "--wrap=none",
  ], { input: reflowed, encoding: "utf-8" });

  if (result.status !== 0) {
    const err = result.stderr || result.stdout || "unknown pandoc error";
    throw new Error(`pandoc failed: ${err}`);
  }

  const body = result.stdout.trim();

  // Build frontmatter HTML
  const frontmatterHtml = frontmatter ? buildFrontmatterHtml(frontmatter) : "";

  // Build TOC from rendered headings
  const tocEntries = extractToc(body);
  const tocHtml = buildTocHtml(tocEntries);

  // Prefer the document's H1 as the page/tab title so tabs are findable;
  // fall back to the filename when there's no heading to use.
  const h1Entry = tocEntries.find((e) => e.level === 1);
  const title = h1Entry ? h1Entry.text : basename(inputPath, extname(inputPath));

  return { title, html: body, frontmatterHtml, tocHtml };
}

function writeStatic(inputPath, outputPath) {
  const { title, html, frontmatterHtml, tocHtml } = renderFile(inputPath);
  const full = buildHtml(title, html, frontmatterHtml, tocHtml, false, opts.theme);
  writeFileSync(outputPath, full);
  console.log(`  wrote ${outputPath}`);
}

function daemonStatePath(port) {
  const configDir = process.env.SPOTLIGHT_MD_CONFIG_DIR || join(homedir(), ".config", "spotlight-md");
  mkdirSync(configDir, { recursive: true, mode: 0o700 });
  return join(configDir, `daemon-${port}.json`);
}

function virtualDocumentRoute(inputPath) {
  const renderedPath = inputPath.replace(/\.md$/i, ".html");
  const segments = renderedPath.replace(/\\/g, "/").split("/").filter(Boolean);
  return "/spotlight/" + segments.map((segment) => encodeURIComponent(segment).replace(/[!'()*]/g, (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`)).join("/");
}

function normalizeUrlPath(pathname) {
  return pathname.split("/").map((segment) => encodeURIComponent(decodeURIComponent(segment)).replace(/[!'()*]/g, (char) => `%${char.charCodeAt(0).toString(16).toUpperCase()}`)).join("/");
}

function readRequestBody(req, limit = 1024 * 1024) {
  return new Promise((resolveBody, rejectBody) => {
    let data = "";
    req.setEncoding("utf8");
    req.on("data", (chunk) => {
      data += chunk;
      if (data.length > limit) rejectBody(new Error("request body too large"));
    });
    req.on("end", () => resolveBody(data));
    req.on("error", rejectBody);
  });
}

function sendJson(res, status, value, extraHeaders = {}) {
  res.writeHead(status, { "Content-Type": "application/json", "Cache-Control": "no-store", ...extraHeaders });
  res.end(JSON.stringify(value));
}

function createDocumentState(inputPath, theme, session, onActivity) {
  const document = {
    path: inputPath,
    route: virtualDocumentRoute(inputPath),
    theme,
    session,
    title: "",
    html: "",
    frontmatterHtml: "",
    tocHtml: "",
    mtime: 0,
    clients: [],
    debounceTimer: null,
    watcher: null,
    lastActivityAt: null,
    activitySequence: 0,
  };

  rebuildDocument(document);
  document.watcher = () => {
    if (document.debounceTimer) clearTimeout(document.debounceTimer);
    document.debounceTimer = setTimeout(() => {
      try {
        rebuildDocument(document);
        onActivity(document);
        broadcastDocument(document, "content-updated");
      } catch (error) {
        console.error(`spotlight-md: could not re-render ${document.path}: ${error.message}`);
      }
    }, 150);
  };
  watchFile(document.path, { interval: 500 }, document.watcher);
  return document;
}

function rebuildDocument(document) {
  const rendered = renderFile(document.path);
  document.title = rendered.title;
  document.html = rendered.html;
  document.frontmatterHtml = rendered.frontmatterHtml;
  document.tocHtml = rendered.tocHtml;
  document.mtime = statSync(document.path).mtimeMs;
}

function broadcastDocument(document, event) {
  for (const client of document.clients) client.write(`event: ${event}\ndata: {}\n\n`);
}

function closeDocumentState(document) {
  if (document.debounceTimer) clearTimeout(document.debounceTimer);
  if (document.watcher) unwatchFile(document.path, document.watcher);
  for (const client of document.clients) client.end();
  document.clients.length = 0;
}

async function handleDocumentRequest(document, subpath, req, res, daemonContext) {
  if (subpath === "" && req.method === "GET") {
    daemonContext.markActive(document);
    res.writeHead(200, { "Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store" });
    res.end(buildHtml(document.title, document.html, document.frontmatterHtml, document.tocHtml, true, document.theme, document.route, daemonContext.recentDocuments()));
    return;
  }

  if (subpath === "/__reload__" && req.method === "GET") {
    res.writeHead(200, {
      "Content-Type": "text/event-stream",
      "Cache-Control": "no-cache",
      Connection: "keep-alive",
    });
    res.write("retry: 2000\n\n");
    document.clients.push(res);
    req.on("close", () => {
      const index = document.clients.indexOf(res);
      if (index !== -1) document.clients.splice(index, 1);
    });
    return;
  }

  if (subpath === "/__session__" && req.method === "GET") {
    sendJson(res, 200, { id: document.session.id, path: document.session.path, state: document.session.state });
    return;
  }
  if (subpath === "/__highlights__" && req.method === "GET") {
    sendJson(res, 200, loadHighlightsWithSuggestions(document.session.id));
    return;
  }
  // Rendered fragments for in-place (no-reload) live updates.
  if (subpath === "/__content__" && req.method === "GET") {
    sendJson(res, 200, { title: document.title, bodyHtml: document.html, frontmatterHtml: document.frontmatterHtml, tocHtml: document.tocHtml });
    return;
  }
  // Whole-document message to the AI (from the composer under the TOC).
  if (subpath === "/__directives__" && req.method === "POST") {
    const data = JSON.parse(await readRequestBody(req));
    const text = (data.text || "").trim();
    if (text.length < 2) { sendJson(res, 400, { error: "text required" }); return; }
    const hl = addHighlight(document.session.id, { text, scope: "document", sectionTitle: "Whole document" });
    daemonContext.markActive(document);
    sendJson(res, 201, hl);
    broadcastDocument(document, "highlights-updated");
    return;
  }
  if (subpath === "/__highlights__" && req.method === "POST") {
    const data = JSON.parse(await readRequestBody(req));
    if (!data.text || data.text.trim().length < 2) {
      sendJson(res, 400, { error: "text required" });
      return;
    }
    const highlight = addHighlight(document.session.id, data);
    daemonContext.markActive(document);
    sendJson(res, 201, highlight, { Location: `${document.route}/__highlights__/${highlight.id}` });
    broadcastDocument(document, "highlights-updated");
    return;
  }

  const highlightMatch = subpath.match(/^\/__highlights__\/([^/]+)$/);
  if (highlightMatch && req.method === "DELETE") {
    const id = highlightMatch[1];
    const removed = setHighlightResolved(document.session.id, id, true, true);
    if (!removed) sendJson(res, 404, { error: "not found" });
    else {
      daemonContext.markActive(document);
      sendJson(res, 200, { ok: true, id });
      broadcastDocument(document, "highlights-updated");
    }
    return;
  }
  if (highlightMatch && req.method === "PATCH") {
    sendJson(res, 410, { error: "editing an initial note is not supported" });
    return;
  }

  const messageMatch = subpath.match(/^\/__highlights__\/([^/]+)\/messages$/);
  if (messageMatch && req.method === "POST") {
    const data = JSON.parse(await readRequestBody(req));
    if (!data.text || data.text.trim().length < 1) {
      sendJson(res, 400, { error: "text required" });
      return;
    }
    const result = addHighlightMessage(document.session.id, messageMatch[1], data.author || "ai", data.text.trim(), data.agentId || null);
    if (!result) sendJson(res, 404, { error: "highlight not found" });
    else {
      daemonContext.markActive(document);
      sendJson(res, 200, result);
      broadcastDocument(document, "highlights-updated");
    }
    return;
  }

  const resolvedMatch = subpath.match(/^\/__highlights__\/([^/]+)\/(resolve|unresolve)$/);
  if (resolvedMatch && req.method === "PATCH") {
    const highlight = setHighlightResolved(document.session.id, resolvedMatch[1], resolvedMatch[2] === "resolve");
    if (!highlight) sendJson(res, 404, { error: "not found" });
    else {
      daemonContext.markActive(document);
      sendJson(res, 200, highlight);
      broadcastDocument(document, "highlights-updated");
    }
    return;
  }

  const suggAcceptMatch = subpath.match(/^\/__suggestions__\/([^/]+)\/accept$/);
  if (suggAcceptMatch && req.method === "PATCH") {
    let result;
    try { result = acceptSuggestion(document.session.id, suggAcceptMatch[1]); }
    catch (e) { result = { error: e.message }; }
    if (result.applied) {
      daemonContext.markActive(document);
      sendJson(res, 200, result.suggestion);
      broadcastDocument(document, "highlights-updated");
      // The file write triggers the watcher too, but nudge immediately so it feels instant.
      try { rebuildDocument(document); } catch (e) { /* ignore */ }
      broadcastDocument(document, "content-updated");
    } else {
      sendJson(res, result.error === "not found" ? 404 : 409, { error: result.error || "could not apply suggestion" });
    }
    return;
  }
  const suggRejectMatch = subpath.match(/^\/__suggestions__\/([^/]+)\/reject$/);
  if (suggRejectMatch && req.method === "PATCH") {
    const updated = setSuggestionStatus(document.session.id, suggRejectMatch[1], "rejected");
    if (updated) {
      daemonContext.markActive(document);
      sendJson(res, 200, updated);
      broadcastDocument(document, "highlights-updated");
    } else {
      sendJson(res, 404, { error: "not found" });
    }
    return;
  }

  if (subpath === "/__mtime__" && req.method === "GET") {
    res.writeHead(200, { "Content-Type": "text/plain", "Cache-Control": "no-store" });
    res.end(String(document.mtime));
    return;
  }

  sendJson(res, 404, { error: "not found" });
}

function serveDaemon(daemonOpts) {
  const token = process.env.SPOTLIGHT_MD_DAEMON_TOKEN || randomBytes(24).toString("hex");
  const statePath = daemonStatePath(daemonOpts.port);
  const documentsByRoute = new Map();
  const documentsByPath = new Map();
  const startedAt = new Date().toISOString();
  let activitySequence = 0;
  let shuttingDown = false;

  function markActive(document) {
    document.activitySequence = ++activitySequence;
    document.lastActivityAt = new Date().toISOString();
  }

  function recentDocuments() {
    return [...documentsByPath.values()]
      .sort((left, right) => right.activitySequence - left.activitySequence)
      .map((document) => ({
        path: document.path,
        route: document.route,
        sessionId: document.session.id,
        lastActivityAt: document.lastActivityAt,
      }));
  }

  const daemonContext = { markActive, recentDocuments };

  // Watch the highlight DB so CLI-driven changes (comments, suggestions, claims)
  // appear live in every open document without needing a source edit.
  const highlightsDbPath = dbFilePath();
  let dbDebounce = null;
  const onDbChange = () => {
    if (dbDebounce) clearTimeout(dbDebounce);
    dbDebounce = setTimeout(() => {
      for (const document of documentsByPath.values()) broadcastDocument(document, "highlights-updated");
    }, 120);
  };
  watchFile(highlightsDbPath + "-wal", { interval: 300 }, onDbChange);
  watchFile(highlightsDbPath, { interval: 500 }, onDbChange);

  function isAuthorized(req) {
    return req.headers["x-spotlight-token"] === token;
  }

  function status() {
    return {
      service: "spotlight-md",
      version: VERSION,
      running: true,
      pid: process.pid,
      port: daemonOpts.port,
      startedAt,
      documents: recentDocuments(),
    };
  }

  const server = createServer(async (req, res) => {
    try {
      const url = new URL(req.url || "/", "http://localhost");
      const pathname = normalizeUrlPath(url.pathname);
      if (pathname === "/__spotlight__/health" && req.method === "GET") {
        sendJson(res, 200, { service: "spotlight-md", version: VERSION });
        return;
      }
      if (pathname === "/__spotlight__/status" && req.method === "GET") {
        if (!isAuthorized(req)) {
          sendJson(res, 403, { error: "forbidden" });
          return;
        }
        sendJson(res, 200, status());
        return;
      }
      if (pathname === "/__spotlight__/register" && req.method === "POST") {
        if (!isAuthorized(req)) {
          sendJson(res, 403, { error: "forbidden" });
          return;
        }
        const registration = JSON.parse(await readRequestBody(req));
        if (!registration.path || typeof registration.path !== "string") {
          sendJson(res, 400, { error: "path required" });
          return;
        }
        const canonicalPath = realpathSync(registration.path);
        if (!statSync(canonicalPath).isFile()) {
          sendJson(res, 400, { error: "path must be a file" });
          return;
        }
        const session = getOrCreateSession(canonicalPath, !!registration.newSession);
        let document = documentsByPath.get(canonicalPath);
        if (document) {
          document.theme = registration.theme || "github-dark";
          document.session = session;
          rebuildDocument(document);
          markActive(document);
          broadcastDocument(document, "reload");
        } else {
          document = createDocumentState(canonicalPath, registration.theme || "github-dark", session, markActive);
          if (documentsByRoute.has(document.route)) throw new Error("document route collision");
          documentsByPath.set(canonicalPath, document);
          documentsByRoute.set(document.route, document);
          markActive(document);
        }
        sendJson(res, 200, {
          sessionId: session.id,
          path: canonicalPath,
          resumed: session.resumed,
          route: document.route,
          url: `http://localhost:${daemonOpts.port}${document.route}`,
        });
        return;
      }
      if (pathname === "/__spotlight__/stop" && req.method === "POST") {
        if (!isAuthorized(req)) {
          sendJson(res, 403, { error: "forbidden" });
          return;
        }
        sendJson(res, 200, { ok: true, pid: process.pid });
        setTimeout(shutdown, 10);
        return;
      }

      let matchedDocument = documentsByRoute.get(pathname);
      let subpath = "";
      if (!matchedDocument) {
        for (const [route, document] of documentsByRoute) {
          if (pathname.startsWith(route + "/__")) {
            matchedDocument = document;
            subpath = pathname.slice(route.length);
            break;
          }
        }
      }
      if (!matchedDocument) {
        sendJson(res, 404, { error: "document is not registered" });
        return;
      }
      await handleDocumentRequest(matchedDocument, subpath, req, res, daemonContext);
    } catch (error) {
      if (!res.headersSent) sendJson(res, error instanceof URIError ? 400 : 500, { error: error.message });
      else res.end();
    }
  });

  function removeOwnStateFile() {
    try {
      const state = JSON.parse(readFileSync(statePath, "utf8"));
      if (state.pid === process.pid && state.token === token) unlinkSync(statePath);
    } catch { /* State may already be absent or replaced by another daemon. */ }
  }

  function shutdown() {
    if (shuttingDown) return;
    shuttingDown = true;
    unwatchFile(highlightsDbPath + "-wal", onDbChange);
    unwatchFile(highlightsDbPath, onDbChange);
    for (const document of documentsByPath.values()) closeDocumentState(document);
    removeOwnStateFile();
    server.close(() => process.exit(0));
    setTimeout(() => process.exit(0), 1000).unref();
  }

  server.on("error", (error) => {
    console.error(`spotlight-md: daemon could not listen on port ${daemonOpts.port}: ${error.message}`);
    process.exit(1);
  });
  server.listen(daemonOpts.port, "127.0.0.1", () => {
    writeFileSync(statePath, JSON.stringify({ pid: process.pid, port: daemonOpts.port, token, startedAt }) + "\n", { mode: 0o600 });
    chmodSync(statePath, 0o600);
  });
  process.on("SIGINT", shutdown);
  process.on("SIGTERM", shutdown);
}

function readDaemonState(port) {
  try {
    const state = JSON.parse(readFileSync(daemonStatePath(port), "utf8"));
    if (state.port !== port || !Number.isInteger(state.pid) || typeof state.token !== "string") return null;
    return state;
  } catch {
    return null;
  }
}

function removeStaleDaemonState(port) {
  try { unlinkSync(daemonStatePath(port)); }
  catch { /* A missing state file is already clean. */ }
}

async function fetchWithTimeout(url, options = {}, timeoutMs = 1000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    return await fetch(url, { ...options, signal: controller.signal });
  } finally {
    clearTimeout(timer);
  }
}

async function probeDaemon(port) {
  try {
    const response = await fetchWithTimeout(`http://127.0.0.1:${port}/__spotlight__/health`);
    const body = await response.json().catch(() => null);
    return body && body.service === "spotlight-md" ? "running" : "occupied";
  } catch {
    return "stopped";
  }
}

async function daemonRequest(port, state, pathname, method = "GET", body = undefined) {
  const response = await fetchWithTimeout(`http://127.0.0.1:${port}${pathname}`, {
    method,
    headers: {
      "X-Spotlight-Token": state.token,
      ...(body === undefined ? {} : { "Content-Type": "application/json" }),
    },
    body: body === undefined ? undefined : JSON.stringify(body),
  }, 5000);
  const value = await response.json().catch(() => ({ error: `daemon returned HTTP ${response.status}` }));
  if (!response.ok) throw new Error(value.error || `daemon returned HTTP ${response.status}`);
  return value;
}

async function ensureDaemon(port) {
  const initialProbe = await probeDaemon(port);
  if (initialProbe === "running") {
    const state = readDaemonState(port);
    if (!state) throw new Error(`daemon is running on port ${port}, but its control file is unavailable`);
    await daemonRequest(port, state, "/__spotlight__/status");
    return state;
  }
  if (initialProbe === "occupied") throw new Error(`port ${port} is already used by another service`);

  removeStaleDaemonState(port);
  const token = randomBytes(24).toString("hex");
  const child = spawn(process.execPath, [resolve(process.argv[1]), "--daemon", "--port", String(port)], {
    detached: true,
    stdio: "ignore",
    env: { ...process.env, SPOTLIGHT_MD_DAEMON_TOKEN: token },
  });
  child.on("error", () => {});
  child.unref();

  for (let attempt = 0; attempt < 60; attempt++) {
    await new Promise((resolveWait) => setTimeout(resolveWait, 50));
    const probe = await probeDaemon(port);
    if (probe === "occupied") throw new Error(`port ${port} became occupied by another service`);
    if (probe === "running") {
      const state = readDaemonState(port);
      if (state) {
        try {
          await daemonRequest(port, state, "/__spotlight__/status");
          return state;
        } catch { /* The winning daemon may still be publishing its control state. */ }
      }
    }
  }
  throw new Error(`timed out starting daemon on port ${port}`);
}

function openBrowser(url) {
  const command = process.platform === "darwin" ? "open" : process.platform === "win32" ? "cmd" : "xdg-open";
  const args = process.platform === "win32" ? ["/c", "start", "", url] : [url];
  const child = spawn(command, args, { stdio: "ignore", detached: true });
  child.on("error", () => {});
  child.unref();
}

async function registerWithDaemon(inputPath, registrationOpts) {
  const state = await ensureDaemon(registrationOpts.port);
  return daemonRequest(registrationOpts.port, state, "/__spotlight__/register", "POST", {
    path: inputPath,
    theme: registrationOpts.theme,
    newSession: registrationOpts.newSession,
  });
}

async function daemonStatus(port) {
  const probe = await probeDaemon(port);
  if (probe !== "running") {
    if (probe === "stopped") removeStaleDaemonState(port);
    return { service: "spotlight-md", running: false, port, reason: probe === "occupied" ? "port occupied by another service" : undefined };
  }
  const state = readDaemonState(port);
  if (!state) throw new Error(`daemon is running on port ${port}, but its control file is unavailable`);
  return daemonRequest(port, state, "/__spotlight__/status");
}

async function stopDaemon(port) {
  const current = await daemonStatus(port);
  if (!current.running) return { ok: false, running: false, port };
  const state = readDaemonState(port);
  return daemonRequest(port, state, "/__spotlight__/stop", "POST");
}


// ── Entry ──────────────────────────────────────────────────────────────────
const opts = parseArgs(process.argv.slice(2));

if (!Number.isInteger(opts.port) || opts.port < 1 || opts.port > 65535) {
  console.error("spotlight-md: --port must be an integer between 1 and 65535");
  process.exit(1);
}

// The persistent multi-document daemon process.
if (opts.daemon) {
  serveDaemon(opts);
  await new Promise(() => {});
}

// ── Prime: AI agent instructions ───────────────────────────────────────────
if (opts.prime) {
  console.log(`# spotlight-md — Collaborative Review Guide for AI Agents

spotlight-md is a human-and-agent document review service. A human reads a
rendered Markdown document in the browser and creates highlight threads. You
address those threads by editing the source document, replying with evidence,
and waiting for the next human response.

## Start or join a review

The human normally starts the browser review surface:

  spotlight-md --auto --json path/to/document.md

The first JSON line contains the sessionId. Reuse that session ID for every
agent command. Do not use paths for highlight operations. An active session is
resumed automatically for a document; --new-session deliberately starts a new
review round.

## Agent loop

Choose a stable agent ID for this run, for example codex-session-abc123.

1. Wait for human work:

     spotlight-md get-new-comments --session-id sp-… --agent-id codex-session-abc123 --wait --json

   This returns immediately if work is already unread, otherwise blocks until a
   highlight or a new human comment arrives. A highlight without a note is also
   work: inspect it and the document context.

   Items come in two scopes (see each item's "scope" field):
     - "text": a highlighted passage. The "text" field is the exact passage;
       address it in place.
     - "document": a whole-document message the human typed in the composer
       (id starts with dm-), e.g. "add a joke to the end of each section". There
       is no single passage — apply the instruction across the document, which
       usually means several suggest-edit calls (one per location) all tied to
       the directive's --highlight-id, plus one add-comment summarizing.

   Section numbers: the UI numbers headings LaTeX-style (each "## " heading is
   section N in order — 1, 2, 3 … — and each "### " heading is N.M). These
   numbers are display-only and are NOT in the markdown source, so when the
   human refers to "section 2.1", use the "currentToc" field included on every
   document item: it is the live numbered outline, e.g.
     [{ "number": "2", "title": "Downtown", "level": 2 },
      { "number": "2.1", "title": "Where to eat", "level": 3 }, … ]
   Look up the referenced number to get the exact heading text, then edit under
   that heading.

2. Read the complete thread when needed:

     spotlight-md get-highlight-details --session-id sp-… --highlight-id hl-… --json

   As soon as you start working on a highlight, claim it so the reviewer sees
   a live "thinking" pulse on that exact passage:

     spotlight-md ai-agent-claim --session-id sp-… --highlight-id hl-… --agent-id codex-session-abc123 --json

   The claim is released automatically when you reply, suggest an edit, or
   complete the highlight (the passage then flashes green for the reviewer).
   Release it manually with --release if you decide not to act on it.

3. Edit the Markdown source to address the human’s request. Preserve the
   surrounding intent; do not change unrelated material.

4. Reply with what changed and why:

     spotlight-md add-comment --session-id sp-… --highlight-id hl-… --agent-id codex-session-abc123 --comment "Reworked the recommendation and added the evaluation gate." --json

   Adding a comment advances your read cursor. If you only inspected a thread,
   use ai-agent-mark-read instead.

   Instead of editing the document directly, you can propose a *suggested edit*
   the human approves or dismisses in the browser (Google-Docs style). This is
   the preferred way to change prose the human highlighted, because they see the
   exact before/after inline and stay in control:

     spotlight-md suggest-edit --session-id sp-… --highlight-id hl-… \\
       --anchor "the exact text to replace, verbatim from the markdown" \\
       --replacement "the improved text" \\
       --comment "Acknowledged — here is a simpler phrasing." --agent-id codex-session-abc123 --json

   For --anchor, the highlight's own text (the "text" field from
   get-new-comments) is usually the best choice. Anchor matching tolerates
   whitespace and line-wrapping differences, so text copied from the rendered
   document still matches hard-wrapped markdown source — the words and
   punctuation must match, but you do NOT need to reproduce the source's line
   breaks. If the anchor can't be located, the approve fails with a clear error
   and nothing changes.

   To INSERT new content instead of replacing, put the anchor text at the start
   of --replacement and append the new material after it. For example, to add a
   section after a paragraph, anchor on that paragraph and make --replacement
   the same paragraph followed by "\\n\\n## New section\\n\\n…".

   On approval the tool splices replacement in place and the browser updates
   live; on dismissal nothing changes. --comment optionally posts a note into
   the thread in the same call. The suggestion appears the instant you run the
   command — the human does not need to reload. Use add-comment (not
   suggest-edit) when the answer is a discussion rather than a concrete text
   change. Multiple highlights may be returned at once — address each one.

5. Continue waiting. Do not complete a highlight merely because you replied.
   Complete it only when the human explicitly asks or the agreed workflow says
   it is done:

     spotlight-md ai-agent-mark-as-completed --session-id sp-… --highlight-id hl-… --agent-id codex-session-abc123 --comment "Completed after the requested review." --json

## End the review

When the human is satisfied, close the session:

  spotlight-md close-session --session-id sp-…

This freezes the review and emits a Markdown audit record containing the
baseline-to-current document changes and the complete highlight/message trail.
Use reopen-session only when the human deliberately resumes the review.

## Rules

- Keep comments specific and factual: say what changed, what remains, or why a
  request needs a decision.
- Never silently discard or overwrite a human highlight.
- Do not resolve, complete, or close a review without the human’s direction.
- Use --json for all automation. Session data is stored centrally in
  ~/.config/spotlight-md/global-highlights-db.db, not in the document repo.`);
  process.exit(0);
}


function requireSession() {
  if (!opts.sessionId) throw new Error("--session-id is required");
  const session = getSession(opts.sessionId);
  if (!session) throw new Error(`session ${opts.sessionId} not found`);
  return session;
}

function emit(value) { console.log(opts.json ? JSON.stringify(value) : typeof value === "string" ? value : JSON.stringify(value, null, 2)); }

// Read unread updates, tolerating transient SQLite lock contention (the server,
// the CLI, and the DB watcher all touch the same database). A momentary
// SQLITE_BUSY must not kill a long-lived `get-new-comments --wait`.
function getUnreadSafe(sessionId, agentId) {
  try { return getUnread(sessionId, agentId); }
  catch (e) {
    if (e && (e.errcode === 5 || e.errcode === 6 || /locked|busy/i.test(e.message || ""))) return null;
    throw e;
  }
}

async function waitForUpdates(sessionId, agentId) {
  let updates = getUnreadSafe(sessionId, agentId);
  if ((updates && updates.length) || !opts.wait) return updates || [];
  return new Promise((resolveWait) => {
    const timer = setInterval(() => {
      const u = getUnreadSafe(sessionId, agentId);
      if (u && u.length) { clearInterval(timer); resolveWait(u); }
    }, 250);
  });
}

try {
  if (opts.command) {
    if (opts.command === "status") {
      const current = await daemonStatus(opts.port);
      emit(current);
      process.exit(current.running ? 0 : 1);
    }
    if (opts.command === "stop") {
      const stopped = await stopDaemon(opts.port);
      emit(stopped);
      process.exit(stopped.ok ? 0 : 1);
    }
    const session = requireSession();
    if (opts.command === "list-highlights") {
      emit(loadHighlights(session.id).map((h) => ({ id: h.id, text: h.text.slice(0, 120), commentCount: h.messages.length, status: h.completed ? "completed" : h.resolved ? "resolved" : "open", createdAt: h.createdAt })));
    } else if (opts.command === "get-highlight-details") {
      if (!opts.highlightId) throw new Error("--highlight-id is required");
      const highlight = loadHighlights(session.id).find((h) => h.id === opts.highlightId);
      if (!highlight) throw new Error(`highlight ${opts.highlightId} not found`);
      emit(withCurrentToc(highlight, session.path));
    } else if (opts.command === "get-new-comments") {
      if (!opts.agentId) throw new Error("--agent-id is required");
      const updates = await waitForUpdates(session.id, opts.agentId);
      emit(updates.map((h) => withCurrentToc(h, session.path)));
    } else if (opts.command === "ai-agent-mark-read") {
      if (!opts.highlightId || !opts.agentId) throw new Error("--highlight-id and --agent-id are required");
      if (!markRead(session.id, opts.highlightId, opts.agentId)) throw new Error(`highlight ${opts.highlightId} not found`);
      emit({ ok: true, highlightId: opts.highlightId, agentId: opts.agentId });
    } else if (opts.command === "add-comment") {
      if (!opts.highlightId || !opts.comment) throw new Error("--highlight-id and --comment are required");
      const result = addHighlightMessage(session.id, opts.highlightId, "ai", opts.comment, opts.agentId);
      if (!result) throw new Error(`highlight ${opts.highlightId} not found`);
      releaseAiClaim(session.id, opts.highlightId);
      if (opts.agentId) markRead(session.id, opts.highlightId, opts.agentId);
      emit(result);
    } else if (opts.command === "suggest-edit") {
      if (!opts.anchor || opts.replacement === null) throw new Error("--anchor and --replacement are required");
      const suggestion = addSuggestion(session.id, { highlightId: opts.highlightId || null, anchor: opts.anchor, replacement: opts.replacement, agentId: opts.agentId });
      // Optionally post the AI's note into the highlight thread in the same call.
      let message;
      if (opts.highlightId && opts.comment) {
        const r = addHighlightMessage(session.id, opts.highlightId, "ai", opts.comment, opts.agentId);
        message = r ? r.message : undefined;
      }
      if (opts.highlightId) releaseAiClaim(session.id, opts.highlightId);
      if (opts.highlightId && opts.agentId) markRead(session.id, opts.highlightId, opts.agentId);
      emit({ suggestion, message });
    } else if (opts.command === "list-suggestions") {
      emit(loadSuggestions(session.id, opts.highlightId ? { highlightId: opts.highlightId } : {}));
    } else if (opts.command === "ai-agent-claim") {
      if (!opts.highlightId) throw new Error("--highlight-id is required");
      if (!setAiClaim(session.id, opts.highlightId, opts.agentId, !opts.release)) throw new Error(`highlight ${opts.highlightId} not found`);
      emit({ ok: true, highlightId: opts.highlightId, state: opts.release ? "idle" : "thinking" });
    } else if (opts.command === "ai-agent-mark-as-completed") {
      if (!opts.highlightId || !opts.comment) throw new Error("--highlight-id and --comment are required");
      const result = addHighlightMessage(session.id, opts.highlightId, "ai", opts.comment, opts.agentId);
      if (!result || !setHighlightResolved(session.id, opts.highlightId, true, true)) throw new Error(`highlight ${opts.highlightId} not found`);
      releaseAiClaim(session.id, opts.highlightId);
      if (opts.agentId) markRead(session.id, opts.highlightId, opts.agentId);
      emit({ ok: true, highlightId: opts.highlightId, status: "completed" });
    } else if (opts.command === "close-session") {
      emit(closeSession(session.id));
    } else if (opts.command === "reopen-session") {
      const db = openDb();
      try { db.prepare("UPDATE sessions SET state = 'active', closed_at = NULL WHERE id = ?").run(session.id); } finally { db.close(); }
      emit({ ok: true, sessionId: session.id, state: "active" });
    }
    process.exit(0);
  }

  if (opts.files.length === 0) throw new Error("Usage: spotlight-md --auto FILE.md | spotlight-md -o OUTPUT.html FILE.md | spotlight-md status");
  if (opts.files.length > 1) throw new Error("exactly one Markdown file is supported per invocation");
  const inputPath = resolve(opts.files[0]);
  statSync(inputPath);
  if (opts.auto) {
    if (opts.output) throw new Error("--auto and --output cannot be combined; use -o without --auto for a static export");
    // Register the document with the persistent daemon (starting it if needed),
    // then hand back its virtual route. Each registered document keeps its own
    // review session, live-reload channel, and highlight/suggestion state.
    const registration = await registerWithDaemon(inputPath, opts);
    if (opts.json) console.log(JSON.stringify(registration));
    else {
      console.log(`  spotlight-md registered ${registration.path}`);
      console.log(`  session: ${registration.sessionId}${registration.resumed ? " (resumed)" : ""}`);
      console.log(`  → ${registration.url}`);
    }
    if (opts.open) openBrowser(registration.url);
  } else {
    const outputPath = resolve(opts.output || inputPath.replace(/\.md$/i, ".html"));
    writeStatic(inputPath, outputPath);
  }
} catch (e) {
  console.error(`spotlight-md: ${e.message}`);
  process.exit(1);
}
