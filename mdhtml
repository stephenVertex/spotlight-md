function buildHtml(title, bodyHtml, frontmatterHtml, tocHtml, autoMode, themeName) {
  const reloadScript = autoMode
    ? `<div id="reload-badge">Reloading…</div>
<script>
(function(){
  var badge = document.getElementById('reload-badge');
  function showBadge(){ badge.classList.add('show'); }
  try {
    var es = new EventSource('/__reload__');
    es.addEventListener('reload', function(){
      showBadge();
      setTimeout(function(){ location.reload(); }, 200);
    });
  } catch(e){
    setInterval(function(){
      fetch('/__mtime__').then(r=>r.text()).then(function(t){
